{%- if section.settings.mostrar_anuncio -%}
<div class="anuncio">
  <div class="anuncio-pista">
    <span class="anuncio-item">{{ section.settings.anuncio_1 }}</span>
    {%- if section.settings.anuncio_2 != blank -%}
      <span class="punto opcional" aria-hidden="true"></span>
      <span class="anuncio-item opcional">{{ section.settings.anuncio_2 }}</span>
    {%- endif -%}
    {%- if section.settings.anuncio_3 != blank -%}
      <span class="punto opcional" aria-hidden="true"></span>
      <span class="anuncio-item opcional">{{ section.settings.anuncio_3 }}</span>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<!-- ===================== PORTADA ===================== -->
<section class="portada" id="portada">
  <div class="portada-fondo" aria-hidden="true">
    <div class="reticula"><span></span><span></span><span></span><span></span><span></span><span></span></div>
  </div>

  <div class="wrap portada-rejilla">
    <div class="portada-texto">
      {%- if section.settings.portada_epigrafe != blank -%}
        <p class="eyebrow rev">{{ section.settings.portada_epigrafe }}</p>
      {%- endif -%}

      <h1 class="display rev rev-d1">
        {{ section.settings.portada_titulo }}<br>
        <span class="linea2">{{ section.settings.portada_titulo_2 }}</span>
      </h1>

      <div class="lead rev rev-d2">{{ section.settings.portada_bajada }}</div>

      <div class="portada-ctas rev rev-d3">
        {%- if section.settings.cta_1_texto != blank -%}
          <a href="{{ section.settings.cta_1_url | default: '#cafes' }}" class="btn">
            {{ section.settings.cta_1_texto }}
            <svg class="ln flecha" width="15" height="15" viewBox="0 0 24 24"><use href="#sepia-i-flecha"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_2_texto != blank -%}
          <a href="{{ section.settings.cta_2_url | default: '#suscripcion' }}" class="btn fantasma">{{ section.settings.cta_2_texto }}</a>
        {%- endif -%}
      </div>

      <dl class="portada-datos rev rev-d4">
        <div><dt>{{ section.settings.dato_1_cifra }}</dt><dd>{{ section.settings.dato_1_texto }}</dd></div>
        <div><dt>{{ section.settings.dato_2_cifra }}</dt><dd>{{ section.settings.dato_2_texto }}</dd></div>
        <div><dt>{{ section.settings.dato_3_cifra }}</dt><dd>{{ section.settings.dato_3_texto }}</dd></div>
      </dl>

      <div class="cue rev rev-d5" aria-hidden="true">
        <span class="barra-cue"></span>
        <span class="micro">{{ section.settings.cue_texto }}</span>
      </div>
    </div>

