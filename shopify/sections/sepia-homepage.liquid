        <div class="lead rev rev-d2" style="margin-top:1.2rem">{{ section.settings.susc_bajada }}</div>
      </div>
      <div class="frecuencia rev rev-d3" role="group" aria-label="Elegir frecuencia de envío">
        <button type="button" data-frec="4" data-desc="0.20" aria-pressed="false">Semanal</button>
        <button type="button" data-frec="2" data-desc="0.15" aria-pressed="true">Cada 15 días</button>
        <button type="button" data-frec="1" data-desc="0.10" aria-pressed="false">Mensual</button>
      </div>
    </div>

    <div class="planes">
      {%- for bloque in planes -%}
        <article class="plan rev rev-d{{ forloop.index }}{% if bloque.settings.destacado %} destacado{% endif %}"
                 data-base="{{ bloque.settings.precio_base }}" {{ bloque.shopify_attributes }}>
          {%- if bloque.settings.destacado and bloque.settings.insignia != blank -%}
            <span class="plan-insignia">{{ bloque.settings.insignia }}</span>
          {%- endif -%}
          <h3>{{ bloque.settings.nombre }}</h3>
          <p class="plan-cantidad">{{ bloque.settings.cantidad }}</p>
          <p class="plan-desc">{{ bloque.settings.descripcion }}</p>
          <div class="plan-precio">
            <span class="monto" data-monto></span>
            <span class="periodo">por envío</span>
          </div>
          <p class="plan-ahorro" data-ahorro></p>
          {%- assign beneficios = bloque.settings.beneficios | newline_to_br | split: '<br />' -%}
          <ul class="plan-incluye">
            {%- for b in beneficios -%}
              {%- assign texto = b | strip -%}
              {%- if texto != blank -%}
                <li><svg viewBox="0 0 24 24"><use href="#sepia-i-check"/></svg>{{ texto }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <a href="{{ bloque.settings.url | default: '#' }}"
             class="btn bloque{% unless bloque.settings.destacado %} contorno-claro{% endunless %}">{{ bloque.settings.cta }}</a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

