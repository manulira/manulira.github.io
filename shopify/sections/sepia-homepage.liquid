<!-- ===================== MÉTODO ===================== -->
{%- assign metodos = section.blocks | where: 'type', 'metodo' -%}
{%- if metodos.size > 0 -%}
<section class="seccion arena" id="metodo">
  <div class="wrap">
    <div class="sec-cabecera">
      <div class="sec-texto">
        <p class="eyebrow rev">{{ section.settings.metodo_epigrafe }}</p>
        <h2 class="rev rev-d1">{{ section.settings.metodo_titulo }}<br><em>{{ section.settings.metodo_titulo_2 }}</em></h2>
      </div>
      <div class="lead rev rev-d2">{{ section.settings.metodo_bajada }}</div>
    </div>

    <div class="metodo-rejilla">
      <div class="rev rev-d1">
        <div class="pestanas" role="tablist" aria-label="Métodos de preparación">
          {%- for bloque in metodos -%}
            <button class="pestana" role="tab" type="button"
                    id="tab-{{ section.id }}-{{ forloop.index }}"
                    aria-controls="panel-{{ section.id }}-{{ forloop.index }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    {{ bloque.shopify_attributes }}>{{ bloque.settings.nombre }}</button>
          {%- endfor -%}
        </div>

        {%- for bloque in metodos -%}
          <div class="panel{% if forloop.first %} activo{% endif %}"
               id="panel-{{ section.id }}-{{ forloop.index }}" role="tabpanel"
               aria-labelledby="tab-{{ section.id }}-{{ forloop.index }}" tabindex="0">
            <dl class="panel-especs">
              <div><dt>Proporción</dt><dd>{{ bloque.settings.proporcion }}</dd></div>
              <div><dt>Molienda</dt><dd>{{ bloque.settings.molienda }}</dd></div>
              <div><dt>Agua</dt><dd>{{ bloque.settings.agua }}</dd></div>
              <div><dt>Tiempo</dt><dd>{{ bloque.settings.tiempo }}</dd></div>
            </dl>
            {%- assign pasos = bloque.settings.pasos | newline_to_br | split: '<br />' -%}
            <ol class="pasos">
              {%- for paso in pasos -%}
                {%- assign texto = paso | strip -%}
                {%- if texto != blank -%}<li><p>{{ texto }}</p></li>{%- endif -%}
              {%- endfor -%}
            </ol>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.mostrar_calculadora -%}
      <aside class="calculadora rev rev-d2" aria-label="Calculadora de proporción café y agua">
        <div class="calc-cab">
          <h3>Calculadora</h3>
          <span class="micro" style="color:rgba(241,236,230,.5)">Café · Agua</span>
        </div>

        <div class="calc-visual">
          <svg viewBox="0 0 160 200" aria-hidden="true">
            <path d="M26 26h108l-33 76a9 9 0 0 1-8 5H67a9 9 0 0 1-8-5z" fill="#F1ECE6" opacity=".12"/>
            <path d="M26 26h108l-33 76a9 9 0 0 1-8 5H67a9 9 0 0 1-8-5z" fill="none" stroke="#B6A697" stroke-width="1.4"/>
            <path d="M40 44h80l-21 48a6 6 0 0 1-5 4H66a6 6 0 0 1-5-4z" fill="#7D4047" opacity=".5"/>
            <g stroke="#B6A697" stroke-width=".8" opacity=".5">
              <path d="M58 26 78 106"/><path d="M80 26v81"/><path d="M102 26 82 106"/>
            </g>
            <path d="M22 26h116" stroke="#B6A697" stroke-width="3.2" stroke-linecap="round"/>
            <path d="M80 110v16" stroke="#B6A697" stroke-width="2.2" stroke-linecap="round" opacity=".85"/>
            <clipPath id="sepia-cp-jarra-{{ section.id }}"><path d="M44 130h72v42a16 16 0 0 1-16 16H60a16 16 0 0 1-16-16z"/></clipPath>
            <g clip-path="url(#sepia-cp-jarra-{{ section.id }})">
              <rect data-nivel-agua x="44" y="150" width="72" height="38" fill="#7D4047" opacity=".72"
                    style="transition:y .45s cubic-bezier(.22,.61,.36,1),height .45s cubic-bezier(.22,.61,.36,1)"/>
            </g>
            <path d="M44 130h72v42a16 16 0 0 1-16 16H60a16 16 0 0 1-16-16z" fill="none" stroke="#B6A697" stroke-width="1.4"/>
            <path d="M40 130h80" stroke="#B6A697" stroke-width="2.4" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="campo">
          <label for="cafe-{{ section.id }}">Café en gramos <b data-val-cafe>20 g</b></label>
          <input type="range" id="cafe-{{ section.id }}" data-in-cafe min="10" max="60" step="1" value="20" />
        </div>
        <div class="campo">
          <label for="ratio-{{ section.id }}">Proporción <b data-val-ratio>1:16</b></label>
          <input type="range" id="ratio-{{ section.id }}" data-in-ratio min="13" max="18" step="1" value="16" />
        </div>

        <dl class="calc-salida">
          <div><dt>Agua</dt><dd data-out-agua>320<span> ml</span></dd></div>
          <div><dt>Rinde</dt><dd data-out-tazas>2<span> tazas</span></dd></div>
        </dl>
        <p class="calc-nota">{{ section.settings.calc_nota }}</p>
      </aside>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

