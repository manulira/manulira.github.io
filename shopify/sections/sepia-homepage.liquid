        {%- assign filas = section.settings.horario | newline_to_br | split: '<br />' -%}
        {%- if filas.size > 0 -%}
        <dl class="horario rev rev-d3">
          {%- for fila in filas -%}
            {%- assign partes = fila | strip | split: '|' -%}
            {%- if partes.size > 1 -%}
              <div><dt>{{ partes[0] | strip }}</dt><dd>{{ partes[1] | strip }}</dd></div>
            {%- endif -%}
