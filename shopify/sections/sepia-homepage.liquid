.sepia-home .pie h4{font-size:.645rem;letter-spacing:.2em;text-transform:uppercase;font-family:var(--sans);font-weight:600;color:var(--taupe);margin-bottom:1.2rem}
.sepia-home .pie-lista{display:grid;gap:.72rem}
.sepia-home .pie-lista a{font-size:.875rem;color:rgba(241,236,230,.68);transition:color .3s var(--ease)}
.sepia-home .pie-lista a:hover{color:var(--crema)}
.sepia-home .redes{display:flex;gap:.55rem;margin-top:1.7rem}
.sepia-home .redes a{
  width:38px;height:38px;border:1px solid rgba(241,236,230,.2);border-radius:50%;
  display:grid;place-items:center;transition:background .32s var(--ease),border-color .32s var(--ease),color .32s var(--ease);
}
.sepia-home .redes a:hover{background:var(--crema);color:var(--carbon);border-color:var(--crema)}
.sepia-home .redes svg{width:16px;height:16px;fill:currentColor}
.sepia-home .pie-abajo{
  margin-top:clamp(3rem,6vw,4.5rem);padding-block:1.6rem;border-top:1px solid rgba(241,236,230,.12);
  display:flex;flex-wrap:wrap;gap:1rem 1.8rem;align-items:center;justify-content:space-between;
  font-size:.7rem;color:rgba(241,236,230,.45);
}
.sepia-home .pie-legal{display:flex;flex-wrap:wrap;gap:1.3rem}
.sepia-home .pie-legal a:hover{color:var(--crema)}
.sepia-home .pagos{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap}
.sepia-home .pago{
  height:24px;padding-inline:.55rem;border:1px solid rgba(241,236,230,.18);border-radius:3px;
  display:grid;place-items:center;font-size:.545rem;letter-spacing:.11em;font-weight:600;
  color:rgba(241,236,230,.55);text-transform:uppercase;
}
.sepia-home .velo{
  position:fixed;inset:0;background:rgba(46,46,46,.55);backdrop-filter:blur(3px);
  z-index:90;opacity:0;visibility:hidden;transition:opacity .42s var(--ease),visibility .42s;
}
.sepia-home .velo.abierto{opacity:1;visibility:visible}
.sepia-home .panel-lat{
  position:fixed;top:0;right:0;height:100dvh;width:min(420px,100vw);
  background:var(--crema);z-index:95;display:flex;flex-direction:column;
  transform:translateX(100%);transition:transform .5s var(--ease);
  box-shadow:-20px 0 60px -30px rgba(46,46,46,.6);
}
.sepia-home .panel-lat.abierto{transform:none}
.sepia-home .panel-lat.izq{right:auto;left:0;transform:translateX(-100%);box-shadow:20px 0 60px -30px rgba(46,46,46,.6)}
.sepia-home .panel-lat.izq.abierto{transform:none}
.sepia-home .panel-cab{
  display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:1.35rem var(--gutter);border-bottom:1px solid var(--linea);flex:none;
}
.sepia-home .panel-cab h2{font-size:1.2rem}
.sepia-home .panel-cuerpo{flex:1;overflow-y:auto;padding:1.5rem var(--gutter);-webkit-overflow-scrolling:touch}
.sepia-home .panel-pie{padding:1.35rem var(--gutter) calc(1.35rem + env(safe-area-inset-bottom));border-top:1px solid var(--linea);flex:none;background:var(--papel)}
.sepia-home .nav-movil{display:grid;gap:.2rem}
.sepia-home .nav-movil a{
  font-family:var(--serif);font-size:1.85rem;padding-block:.72rem;
  border-bottom:1px solid var(--linea);display:flex;align-items:center;justify-content:space-between;
  transition:color .3s var(--ease),padding-left .3s var(--ease);
}
.sepia-home .nav-movil a:hover{color:var(--vino);padding-left:.4rem}
.sepia-home .nav-movil a small{font-family:var(--sans);font-size:.6rem;letter-spacing:.16em;color:var(--tinta-tenue);text-transform:uppercase}
.sepia-home .item-carro{display:grid;grid-template-columns:68px 1fr auto;gap:1rem;padding-block:1.15rem;border-bottom:1px solid var(--linea);align-items:center}
.sepia-home .item-carro-visual{background:var(--arena-claro);border-radius:var(--r-sm);aspect-ratio:1;display:grid;place-items:center;padding:.4rem}
.sepia-home .item-carro-visual svg{width:68%}
.sepia-home .item-carro h4{font-size:1rem;margin-bottom:.18rem}
.sepia-home .item-carro .sub{font-size:.665rem;letter-spacing:.1em;text-transform:uppercase;color:var(--tinta-tenue)}
.sepia-home .cantidad{display:inline-flex;align-items:center;border:1px solid var(--linea-fuerte);border-radius:100px;margin-top:.5rem}
.sepia-home .cantidad button{width:26px;height:26px;display:grid;place-items:center;font-size:.9rem;line-height:1;color:var(--tinta-media)}
.sepia-home .cantidad button:hover{color:var(--vino)}
.sepia-home .cantidad span{min-width:22px;text-align:center;font-size:.78rem;font-variant-numeric:tabular-nums}
.sepia-home .item-precio{font-family:var(--serif);font-size:1rem;white-space:nowrap}
.sepia-home .carro-vacio{text-align:center;padding:3.5rem 0;color:var(--tinta-tenue)}
.sepia-home .carro-vacio svg{width:46px;height:46px;margin:0 auto 1.2rem;stroke:var(--taupe);stroke-width:1.2;fill:none}
.sepia-home .carro-vacio p{font-family:var(--serif);font-style:italic;font-size:1.15rem;margin-bottom:1.5rem}
.sepia-home .total{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:1.1rem}
.sepia-home .total .etq{font-size:.66rem;letter-spacing:.17em;text-transform:uppercase;color:var(--tinta-media)}
.sepia-home .total .val{font-family:var(--serif);font-size:1.6rem}
.sepia-home .envio-nota{font-size:.72rem;color:var(--tinta-tenue);text-align:center;margin-top:.9rem;line-height:1.5}
.sepia-home .wsp{
  position:fixed;right:clamp(16px,3vw,26px);bottom:clamp(16px,3vw,26px);z-index:80;
  width:52px;height:52px;border-radius:50%;background:var(--carbon);color:var(--crema);
  display:grid;place-items:center;box-shadow:0 14px 34px -14px rgba(46,46,46,.75);
  transition:transform .38s var(--ease),background .38s var(--ease);
}
.sepia-home .wsp:hover{transform:scale(1.08) translateY(-2px);background:var(--vino)}
.sepia-home .wsp svg{width:23px;height:23px;fill:currentColor}
.sepia-home .saltar{
  position:absolute;left:-9999px;top:0;z-index:200;background:var(--vino);color:var(--crema);
  padding:.85rem 1.4rem;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;
}
.sepia-home .saltar:focus{left:12px;top:12px}
.sepia-home .ruta{stroke-dasharray:1;stroke-dashoffset:1}
.sepia-home .rev.visto .ruta{animation:sepia-traza 1.7s var(--ease) forwards}
@keyframes sepia-traza{to{stroke-dashoffset:0}}
.sepia-home .puntos-origen circle{transform-box:fill-box;transform-origin:center;transform:scale(0)}
.sepia-home .rev.visto .puntos-origen circle{animation:sepia-brota .6s var(--ease) forwards}
.sepia-home .rev.visto .puntos-origen circle:nth-child(2){animation-delay:.12s}
.sepia-home .rev.visto .puntos-origen circle:nth-child(3){animation-delay:.24s}
.sepia-home .rev.visto .puntos-origen circle:nth-child(4){animation-delay:.36s}
.sepia-home .rev.visto .puntos-origen circle:nth-child(5){animation-delay:.48s}
@keyframes sepia-brota{to{transform:scale(1)}}
@media(prefers-reduced-motion:reduce){.sepia-home .ruta{stroke-dashoffset:0}
.sepia-home .puntos-origen circle{transform:none}}
.sepia-home .solo-lectores{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(max-width:520px){.sepia-home .pie-foto{right:0;padding:.6rem .85rem;gap:.5rem}
.sepia-home .pie-foto strong{font-size:.85rem}
.sepia-home .pie-foto span{font-size:.53rem;letter-spacing:.12em}
.sepia-home .collage{aspect-ratio:4/4.9}}
.sepia-home .ln{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.sepia-home .sl{fill:currentColor}
</style>

