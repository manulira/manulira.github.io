{%- endif -%}

<!-- ===================== BOLETÍN ===================== -->
{%- if section.settings.mostrar_boletin -%}
<section class="seccion oscuro" id="boletin">
  <div class="wrap">
    <div class="boletin">
      <p class="eyebrow centrado sobre-oscuro rev">{{ section.settings.boletin_epigrafe }}</p>
      <h2 class="rev rev-d1">{{ section.settings.boletin_titulo }}<br><em>{{ section.settings.boletin_titulo_2 }}</em></h2>
      <div class="lead rev rev-d2">{{ section.settings.boletin_bajada }}</div>

      {%- form 'customer', class: 'form-boletin rev rev-d3' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="correo-{{ section.id }}" class="solo-lectores">Tu correo</label>
        <input type="email" id="correo-{{ section.id }}" name="contact[email]"
               placeholder="{{ section.settings.boletin_placeholder }}" required autocomplete="email"
               value="{{ form.email }}">
        <button class="btn claro" type="submit">{{ section.settings.boletin_cta }}</button>
        {%- if form.posted_successfully? -%}
          <p class="form-ok visible" style="flex:1 1 100%" role="status">{{ section.settings.boletin_gracias }}</p>
        {%- elsif form.errors -%}
          <p class="form-ok visible" style="flex:1 1 100%;border-color:#7D4047" role="alert">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}
      {%- endform -%}

      <p class="form-nota rev rev-d4">{{ section.settings.boletin_nota }}</p>
    </div>
  </div>
</section>
{%- endif -%}

{%- if section.settings.whatsapp != blank -%}
  <a class="wsp" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}"
     target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#sepia-i-wsp"/></svg>
  </a>
{%- endif -%}

</div>

<style>
  .sepia-home .cafe-visual img,.sepia-home .articulo-visual img,
  .sepia-home .visita-visual img,.sepia-home .marco-principal img{
    width:100%;height:100%;object-fit:cover;display:block;
  }
  .sepia-home .cafe-enlace{display:block;color:inherit}
  .sepia-home .cafe h3 a{color:inherit;transition:color .3s var(--ease)}
  .sepia-home .cafe:hover h3 a{color:var(--vino)}
  .sepia-home .agregar[disabled]{opacity:.45;cursor:not-allowed}
  .sepia-home .agregar[disabled]:hover{background:none;color:inherit}
  .sepia-home .lead p:not(:last-child),.sepia-home .plan-desc p:not(:last-child){margin-bottom:.8rem}
  .sepia-home .lead p:last-child{margin-bottom:0}
</style>

<script>
(function(){
  "use strict";
  var ID = "{{ section.id }}";
  var MONEDA = {{ section.settings.simbolo_moneda | json }};

  function iniciar(){
    var raiz = document.querySelector('[data-sepia-id="' + ID + '"]');
    if(!raiz || raiz.dataset.sepiaListo === "1") return;
    raiz.dataset.sepiaListo = "1";

    var $  = function(s){ return raiz.querySelector(s); };
    var $$ = function(s){ return Array.prototype.slice.call(raiz.querySelectorAll(s)); };
    var clp = function(n){ return MONEDA + Math.round(n).toLocaleString("es-CL"); };
    var menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ---------- Revelados al scroll ---------- */
    var objetivos = $$(".rev");
    if("IntersectionObserver" in window && !menosMovimiento){
      var obs = new IntersectionObserver(function(entradas){
        entradas.forEach(function(e){
          if(e.isIntersecting){ e.target.classList.add("visto"); obs.unobserve(e.target); }
        });
      },{ threshold:.12, rootMargin:"0px 0px -8% 0px" });
      objetivos.forEach(function(el){ obs.observe(el); });
    } else {
      objetivos.forEach(function(el){ el.classList.add("visto"); });
    }

    /* ---------- Cinta de atributos ---------- */
    var cinta = $("[data-cinta-pista]");
    if(cinta){
      var textos = (cinta.parentNode.dataset.cinta || "").split(",")
        .map(function(t){ return t.trim(); }).filter(Boolean);
      if(textos.length){
        var grano = '<svg viewBox="0 0 24 32" aria-hidden="true"><use href="#sepia-i-grano"/></svg>';
        var grupo = '<span class="cinta-grupo">' +
          textos.map(function(t){ return "<span>" + t + "</span>" + grano; }).join("") + "</span>";
        cinta.innerHTML = grupo + grupo;
      }
    }

    /* ---------- Agregar al carrito sin recargar ---------- */
    var insignia = document.querySelector(".cart-count-bubble, [data-cart-count], .cart-count");
    function refrescarCarrito(){
      fetch("/cart.js", { headers:{ "Accept":"application/json" } })
        .then(function(r){ return r.json(); })
        .then(function(c){
          document.dispatchEvent(new CustomEvent("sepia:carrito", { detail:c }));
          if(insignia) insignia.textContent = c.item_count;
        })
        .catch(function(){});
    }
    function enviarAlCarrito(form, boton){
      var datos = new FormData(form);
      boton.disabled = true;
      return fetch("/cart/add.js", {
        method:"POST", headers:{ "Accept":"application/json" }, body:datos
      }).then(function(r){
        if(!r.ok) throw new Error("no");
        var texto = boton.textContent;
        boton.textContent = "Agregado";
        boton.classList.add("hecho");
        boton.disabled = false;
        setTimeout(function(){ boton.textContent = texto; boton.classList.remove("hecho"); }, 1600);
        refrescarCarrito();
      }).catch(function(){
        boton.disabled = false;
        form.submit();   // sin JS o con error, el formulario clásico sigue funcionando
      });
    }
    $$("[data-agregar-form]").forEach(function(form){
      form.addEventListener("submit", function(e){
        if(!window.fetch) return;
        e.preventDefault();
        enviarAlCarrito(form, form.querySelector("button"));
      });
    });

    /* ---------- Filtros del catálogo ---------- */
    var fichas = $$(".cafe"), sinResultados = $("[data-sin-resultados]");
    $$(".filtro").forEach(function(btn){
      btn.addEventListener("click", function(){
        var f = btn.dataset.filtro;
        $$(".filtro").forEach(function(b){ b.setAttribute("aria-pressed", String(b === btn)); });
        var visibles = 0;
        fichas.forEach(function(ficha){
          var ok = f === "todos" || (ficha.dataset.metodo || "").indexOf(f) !== -1;
          ficha.classList.toggle("oculto", !ok);
          if(ok) visibles++;
        });
        if(sinResultados) sinResultados.hidden = visibles > 0;
      });
    });

    /* ---------- Recomendador ---------- */
    var panelResultado = $("[data-reco-resultado]"), barraReco = $("[data-reco-progreso]");
    if(panelResultado && fichas.length){
      var respuestas = [], pasoActual = 1, elegido = null;

      var mostrarPaso = function(n){
        pasoActual = n;
        $$(".paso").forEach(function(p){ p.classList.toggle("activo", parseInt(p.dataset.paso,10) === n); });
        panelResultado.classList.remove("activo");
        if(barraReco) barraReco.style.width = (n/3*100) + "%";
      };
      var puntuar = function(ficha, metodo, leche, perfil){
        var metodos = ficha.dataset.metodo || "";
        var suyo    = ficha.dataset.perfil || "";
        var tueste  = parseInt(ficha.dataset.tueste || "3", 10);
        var p = 0;
        if(metodo === "ambos"){
          p += (metodos.indexOf("filtrado") !== -1 && metodos.indexOf("espresso") !== -1) ? 2 : 1;
        } else if(metodos.indexOf(metodo) !== -1) p += 3;
        if(suyo === perfil) p += 4;
        if(leche === "leche"){ if(suyo === "dulce") p += 2; if(tueste >= 3) p += 1; }
        else { if(suyo === "frutal") p += 2; if(tueste <= 2) p += 1; }
        return p;
      };
      var resolver = function(){
        var mejor = null, top = -1;
        fichas.forEach(function(ficha){
          var p = puntuar(ficha, respuestas[0], respuestas[1], respuestas[2]);
          if(p > top){ top = p; mejor = ficha; }
        });
        if(!mejor) return;
        elegido = mejor;
        var bolsa = $("[data-reco-bolsa]");
        if(bolsa) bolsa.style.setProperty("--acento", mejor.dataset.acento || "#7D4047");
        $("[data-reco-nombre]").textContent = mejor.dataset.nombre || "";
        $("[data-reco-origen]").textContent = mejor.dataset.origen || "";
        $("[data-reco-desc]").textContent   = mejor.dataset.desc || "";
        var precio = $("[data-reco-precio]");
        if(precio) precio.textContent = mejor.dataset.precio || "";
        $$(".paso").forEach(function(p){ p.classList.remove("activo"); });
        panelResultado.classList.add("activo");
        if(barraReco) barraReco.style.width = "100%";
      };

      $$(".paso .opcion").forEach(function(btn){
        btn.addEventListener("click", function(){
          respuestas[pasoActual-1] = btn.dataset.resp;
          if(pasoActual < 3) mostrarPaso(pasoActual+1); else resolver();
        });
      });
      $$("[data-atras]").forEach(function(btn){
        btn.addEventListener("click", function(){ if(pasoActual > 1) mostrarPaso(pasoActual-1); });
      });
      var reiniciar = $("[data-reco-reiniciar]");
      if(reiniciar) reiniciar.addEventListener("click", function(){ respuestas = []; mostrarPaso(1); });
      var agregarReco = $("[data-reco-agregar]");
      if(agregarReco) agregarReco.addEventListener("click", function(){
        if(!elegido) return;
        var form = elegido.querySelector("[data-agregar-form]");
        if(form && window.fetch) enviarAlCarrito(form, agregarReco);
        else if(elegido.dataset.url) window.location.href = elegido.dataset.url;
      });
    }

    /* ---------- Frecuencia de suscripción ---------- */
    var botonesFrec = $$(".frecuencia button");
    function pintarPlanes(enviosMes, descuento){
      $$(".plan").forEach(function(plan){
        var base = parseFloat(plan.dataset.base || "0");
        if(!base) return;
        var porEnvio = base * (1 - descuento);
        var monto = plan.querySelector("[data-monto]");
        var ahorro = plan.querySelector("[data-ahorro]");
        if(monto)  monto.textContent = clp(porEnvio);
        if(ahorro) ahorro.textContent = Math.round(descuento*100) +
          "% menos que comprar suelto · ≈" + clp(porEnvio*enviosMes) + " al mes";
      });
    }
    botonesFrec.forEach(function(btn){
      btn.addEventListener("click", function(){
        botonesFrec.forEach(function(b){ b.setAttribute("aria-pressed", String(b === btn)); });
        pintarPlanes(parseInt(btn.dataset.frec,10), parseFloat(btn.dataset.desc));
      });
    });
    if(botonesFrec.length){
      var activo = botonesFrec.filter(function(b){ return b.getAttribute("aria-pressed") === "true"; })[0] || botonesFrec[0];
      pintarPlanes(parseInt(activo.dataset.frec,10), parseFloat(activo.dataset.desc));
    }

    /* ---------- Pestañas de método ---------- */
    var pestanas = $$(".pestana");
    function activarPestana(tab){
      pestanas.forEach(function(t){ t.setAttribute("aria-selected", String(t === tab)); });
      $$(".panel").forEach(function(p){ p.classList.toggle("activo", p.id === tab.getAttribute("aria-controls")); });
    }
    pestanas.forEach(function(tab, i){
      tab.addEventListener("click", function(){ activarPestana(tab); });
      tab.addEventListener("keydown", function(e){
        var d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if(!d) return;
        e.preventDefault();
        var siguiente = pestanas[(i + d + pestanas.length) % pestanas.length];
        siguiente.focus(); activarPestana(siguiente);
      });
    });

    /* ---------- Calculadora de proporción ---------- */
    var inCafe = $("[data-in-cafe]"), inRatio = $("[data-in-ratio]"), nivel = $("[data-nivel-agua]");
    if(inCafe && inRatio){
      var calcular = function(){
        var g = parseInt(inCafe.value,10), r = parseInt(inRatio.value,10);
        var agua = g * r;
        $("[data-val-cafe]").textContent  = g + " g";
        $("[data-val-ratio]").textContent = "1:" + r;
        $("[data-out-agua]").innerHTML    = agua + "<span> ml</span>";
        var tazas = Math.max(1, Math.round(agua/150));
        $("[data-out-tazas]").innerHTML = tazas + "<span> " + (tazas === 1 ? "taza" : "tazas") + "</span>";
        if(nivel){
          var alto = 58 * Math.max(.12, Math.min(1, agua/760));
          nivel.setAttribute("y", (188 - alto).toFixed(1));
          nivel.setAttribute("height", alto.toFixed(1));
        }
      };
      inCafe.addEventListener("input", calcular);
      inRatio.addEventListener("input", calcular);
      calcular();
    }

    /* ---------- Enlaces internos ---------- */
    $$('a[href^="#"]').forEach(function(a){
      a.addEventListener("click", function(e){
        var id = a.getAttribute("href");
        if(id === "#" || id.length < 2) return;
        var destino = raiz.querySelector(id) || document.querySelector(id);
        if(!destino) return;
        e.preventDefault();
        destino.scrollIntoView({ behavior: menosMovimiento ? "auto" : "smooth", block:"start" });
      });
    });
  }

  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", iniciar);
  else iniciar();
  // El editor de temas vuelve a montar la sección al guardar
  document.addEventListener("shopify:section:load", function(e){
    if(e.detail && e.detail.sectionId === ID) iniciar();
  });
})();
</script>

