<section class="seccion" id="cafes">
  <div class="wrap">
    <div class="sec-cabecera">
      <div class="sec-texto">
        <p class="eyebrow rev">{{ section.settings.cafes_epigrafe }}</p>
        <h2 class="rev rev-d1">{{ section.settings.cafes_titulo }}<br><em>{{ section.settings.cafes_titulo_2 }}</em></h2>
      </div>
      {%- if section.settings.mostrar_filtros -%}
      <div class="filtros rev rev-d2" role="group" aria-label="Filtrar cafés por método">
        <button class="filtro" type="button" data-filtro="todos" aria-pressed="true">Todos</button>
        <button class="filtro" type="button" data-filtro="filtrado" aria-pressed="false">Filtrado</button>
        <button class="filtro" type="button" data-filtro="espresso" aria-pressed="false">Espresso</button>
        <button class="filtro" type="button" data-filtro="descafeinado" aria-pressed="false">Sin cafeína</button>
      </div>
      {%- endif -%}
    </div>

    <div class="rejilla-cafes" data-rejilla>
      {%- if hay_productos -%}
        {%- for producto in coleccion.products limit: section.settings.cantidad -%}
          {%- assign origen = '' -%}{%- assign tueste = 3 -%}{%- assign metodos = '' -%}
          {%- assign perfil = 'equilibrado' -%}{%- assign acento = section.settings.acento_portada -%}
          {%- assign notas = '' -%}
          {%- for t in producto.tags -%}
            {%- if t contains 'origen:' -%}{%- assign origen = t | remove: 'origen:' -%}
            {%- elsif t contains 'tueste:' -%}{%- assign tueste = t | remove: 'tueste:' | times: 1 -%}
            {%- elsif t contains 'metodo:' -%}{%- assign m = t | remove: 'metodo:' -%}{%- assign metodos = metodos | append: m | append: ' ' -%}
            {%- elsif t contains 'perfil:' -%}{%- assign perfil = t | remove: 'perfil:' -%}
            {%- elsif t contains 'acento:' -%}{%- assign acento = t | remove: 'acento:' -%}
            {%- elsif t contains 'nota:' -%}{%- assign nt = t | remove: 'nota:' -%}{%- assign notas = notas | append: nt | append: '||' -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if origen == '' -%}{%- assign origen = producto.type | default: producto.vendor -%}{%- endif -%}
          {%- if metodos == '' -%}{%- assign metodos = 'filtrado espresso' -%}{%- endif -%}
          {%- assign lista_notas = notas | split: '||' -%}
          {%- assign variante = producto.selected_or_first_available_variant -%}
          {%- case tueste -%}
            {%- when 1 -%}{%- assign etq_tueste = 'Claro' -%}
            {%- when 2 -%}{%- assign etq_tueste = 'Medio-claro' -%}
            {%- when 3 -%}{%- assign etq_tueste = 'Medio' -%}
            {%- when 4 -%}{%- assign etq_tueste = 'Medio-oscuro' -%}
            {%- else -%}{%- assign etq_tueste = 'Oscuro' -%}
          {%- endcase -%}

          <article class="cafe rev rev-d{% cycle '1','2','3','4','5','6' %}"
                   data-id="{{ producto.handle }}" data-perfil="{{ perfil }}" data-tueste="{{ tueste }}"
                   data-nombre="{{ producto.title | escape }}" data-precio="{{ producto.price | money }}"
                   data-acento="{{ acento }}" data-metodo="{{ metodos | strip }}"
                   data-origen="{{ origen | escape }}" data-url="{{ producto.url }}"
                   data-desc="{{ producto.description | strip_html | truncate: 210 | escape }}">
            <a class="cafe-enlace" href="{{ producto.url }}" tabindex="-1" aria-hidden="true">
              <div class="cafe-visual">
                <span class="cafe-indice" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- unless producto.available -%}<span class="etiqueta neutra">Agotado</span>{%- endunless -%}
                {%- if producto.featured_image -%}
                  {{ producto.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: producto.title }}
                {%- else -%}
                  <svg class="bolsa" viewBox="0 0 200 272" style="--acento:{{ acento }}"><use href="#sepia-i-bolsa"/></svg>
                {%- endif -%}
              </div>
            </a>
            <div class="cafe-cuerpo">
              <p class="cafe-origen">{{ origen }}</p>
              <h3><a href="{{ producto.url }}">{{ producto.title }}</a></h3>
              {%- if lista_notas.size > 0 -%}
              <ul class="notas">
                {%- for nota in lista_notas -%}<li class="nota">{{ nota }}</li>{%- endfor -%}
              </ul>
              {%- endif -%}
              <div class="medidor">
                <span class="medidor-etq">Tueste</span>
                <span class="puntos" role="img" aria-label="Tueste {{ etq_tueste | downcase }}">
                  {%- for i in (1..5) -%}<i class="{% if i <= tueste %}lleno{% endif %}"></i>{%- endfor -%}
                </span>
                <span class="medidor-etq" style="color:var(--tinta-media)">{{ etq_tueste }}</span>
              </div>
              <div class="cafe-pie">
                <p class="precio">{{ producto.price | money }}<small>{{ variante.title | default: '250 g' }}</small></p>
                <form method="post" action="/cart/add" accept-charset="UTF-8" style="margin:0" data-agregar-form>
                  <input type="hidden" name="form_type" value="product">
                  <input type="hidden" name="utf8" value="✓">
                  <input type="hidden" name="id" value="{{ variante.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="agregar" {% unless producto.available %}disabled{% endunless %}>
                    {%- if producto.available -%}Agregar{%- else -%}Agotado{%- endif -%}
                  </button>
                </form>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}

        <article class="cafe rev rev-d1" data-id="cordillera" data-perfil="dulce" data-tueste="3"
                 data-nombre="Cordillera" data-precio="$9.900" data-acento="#7D4047" data-metodo="filtrado espresso"
