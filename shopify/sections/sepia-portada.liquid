.sepia2 .btn.chico{padding:.62rem 1.15rem;font-size:.85rem;border-width:2px}
.sepia2 .btn.bloque{width:100%}
.sepia2 .enlace-sub{font-family:var(--display);font-weight:600;border-bottom:2px solid currentColor;padding-bottom:2px;white-space:nowrap}
.sepia2 .ic{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.sepia2 .ic-full{fill:currentColor;stroke:none}
.sepia2 .anuncio{
  background:var(--tinta);color:var(--blanco);
  font-size:.82rem;font-weight:500;text-align:center;
  padding:.62rem var(--gutter);position:relative;z-index:60;
}
.sepia2 .anuncio a{border-bottom:1px solid var(--claro-24)}
.sepia2 .anuncio a:hover{border-bottom-color:currentColor}
.sepia2 .cabecera{
