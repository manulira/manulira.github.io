{%- comment -%}
  ============================================================================
  SEPIA — PORTADA v2
  ----------------------------------------------------------------------------
  Portada completa en un solo archivo, con la misma arquitectura que una
  tienda headless: hero en carrusel, cinta de ventajas, carruseles de
  producto, grilla de categorías, testimonios y bloque editorial.

  Instalación
    1. Tienda online → Temas → ··· → Editar código
    2. Secciones → Agregar una sección nueva → nombre: sepia-portada
    3. Borrar el ejemplo, pegar este archivo entero y guardar
    4. En Personalizar, agregar la sección "Sepia — Portada v2"

  Catálogo real
    Elegí una colección en cada carrusel. Etiquetas que lee de cada producto:
      sub:Blend de casa · 250 g     línea bajo el nombre
      tono:#F7D9C4                  color de fondo de la tarjeta
      acento:#8B4A3C                color del envase dibujado
      arte:bolsa                    bolsa · botella · tarro · taza · caja · batidor
      etq:Más vendido               etiqueta de la esquina
      etqc:rojo                     color de la etiqueta: rojo o lima
      muestra:#2F7D4F               una por cada color disponible
    Sin colección elegida se muestran productos de ejemplo.

  El CSS está acotado a .sepia2 y las animaciones llevan prefijo, así que
  no interfiere con el tema. La cabecera y el pie son opcionales: si tu tema
  ya trae los suyos, dejalos apagados.
  ============================================================================
{%- endcomment -%}

<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap');

.sepia2{position:relative;isolation:isolate;text-align:left;font-size:16px}
.sepia2{
  
  --celeste:#C8D9E6;   
  --beige:#F5EFEB;     
  --navy:#2F4156;      
  --teal:#567C8D;      
  --blanco:#FFFFFF;    

  
  --tinta:var(--navy);
  --papel:var(--beige);
  --humo:rgba(47,65,86,.06);

  
  --tinta-70:rgba(47,65,86,.72);
  --tinta-60:rgba(47,65,86,.66);
  --tinta-40:rgba(47,65,86,.45);
  --tinta-14:rgba(47,65,86,.16);
  --tinta-08:rgba(47,65,86,.08);
  
  --claro-24:rgba(255,255,255,.26);
  --claro-64:rgba(255,255,255,.72);

  
  --display:'Poppins',system-ui,sans-serif;
  --sans:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
  --serif:'DM Sans',Georgia,serif;

  
  --ancho:1440px;
  --gutter:clamp(16px,3.4vw,48px);
  --modulo:clamp(48px,7vw,80px);
  --r-xl:28px;
  --r-lg:20px;
  --r-md:14px;
  --r-pill:999px;
  --cab:68px;

  --ease:cubic-bezier(.22,.61,.36,1);
}
.sepia2 *,.sepia2 *::before,.sepia2 *::after{box-sizing:border-box;margin:0;padding:0}
.sepia2{
  font-family:var(--sans);font-size:16px;line-height:1.55;
  color:var(--tinta);background:var(--papel);
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  overflow-x:clip;
}
.sepia2 img,.sepia2 svg,.sepia2 video{display:block;max-width:100%}
.sepia2 button,.sepia2 input,.sepia2 select,.sepia2 textarea{font:inherit;color:inherit}
.sepia2 button{background:none;border:0;cursor:pointer;color:inherit}
.sepia2 a{color:inherit;text-decoration:none}
.sepia2 ul,.sepia2 ol{list-style:none}
.sepia2 :where(a,button,input,select,summary,[tabindex]):focus-visible{
  outline:3px solid var(--tinta);outline-offset:2px;border-radius:6px;
}
.sepia2 .solo-lectores{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.sepia2 h1,.sepia2 h2,.sepia2 h3,.sepia2 h4,.sepia2 .display{font-family:var(--display);font-weight:600;line-height:1.02;letter-spacing:-.02em}
.sepia2 .t-6xl{font-size:clamp(2.7rem,6.4vw,5rem)}
.sepia2 .t-4xl{font-size:clamp(2rem,4.2vw,3.3rem)}
.sepia2 .t-3xl{font-size:clamp(1.7rem,3.2vw,2.5rem)}
.sepia2 .t-2xl{font-size:clamp(1.4rem,2.4vw,1.9rem)}
.sepia2 .t-xl{font-size:1.22rem}
.sepia2 .copy{font-size:clamp(1rem,1.25vw,1.12rem);line-height:1.55}
.sepia2 .micro{font-family:var(--sans);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.sepia2 .wrap{width:100%;max-width:var(--ancho);margin-inline:auto;padding-inline:var(--gutter)}
.sepia2 .modulo{position:relative;width:100%;padding-block:var(--modulo)}
.sepia2 .modulo.sin-top{padding-top:0}
.sepia2 .modulo.sin-bottom{padding-bottom:0}
.sepia2 .panel{background:var(--blanco);border-radius:var(--r-xl);overflow:hidden}
.sepia2 .mod-cab{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin-bottom:clamp(1.5rem,3vw,2.4rem);flex-wrap:wrap}
.sepia2 .mod-cab .copy{margin-top:.5rem;color:var(--tinta-60);max-width:46ch}
.sepia2 .btn{
  --bg:var(--tinta);--fg:var(--blanco);
  display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
  padding:.95rem 1.9rem;background:var(--bg);color:var(--fg);
  border:2px solid var(--bg);border-radius:var(--r-pill);
  font-family:var(--display);font-size:.95rem;font-weight:600;letter-spacing:.01em;
  transition:transform .2s var(--ease),filter .25s var(--ease),background .25s var(--ease),color .25s var(--ease);
  white-space:nowrap;text-align:center;
}
.sepia2 .btn:hover{transform:translateY(-2px);filter:brightness(1.08)}
.sepia2 .btn:active{transform:translateY(0)}
.sepia2 .btn.blanco{--bg:var(--blanco);--fg:var(--tinta)}
.sepia2 .btn.teal{--bg:var(--teal);--fg:var(--blanco)}
.sepia2 .btn.celeste{--bg:var(--celeste);--fg:var(--navy)}
.sepia2 .btn.navy{--bg:var(--navy);--fg:var(--blanco)}
.sepia2 .btn.linea{--bg:transparent;--fg:var(--tinta);border-color:var(--tinta)}
