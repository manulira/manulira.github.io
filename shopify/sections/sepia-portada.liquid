    <div class="boletin rev" style="background:{{ section.settings.bol_fondo }}">
      <h2 class="t-3xl">{{ section.settings.bol_titulo }}</h2>
      {%- if section.settings.bol_copy != blank -%}<p class="copy">{{ section.settings.bol_copy }}</p>{%- endif -%}
      {%- form 'customer', class: 'form-bol' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="correo-{{ section.id }}" class="solo-lectores">Tu correo</label>
        <input type="email" id="correo-{{ section.id }}" name="contact[email]" required autocomplete="email"
               placeholder="{{ section.settings.bol_placeholder }}" value="{{ form.email }}">
        <button class="btn" type="submit">{{ section.settings.bol_cta }}</button>
        {%- if form.posted_successfully? -%}
          <p class="bol-ok visible" style="flex:1 1 100%" role="status">{{ section.settings.bol_gracias }}</p>
        {%- elsif form.errors -%}
          <p class="bol-ok visible" style="flex:1 1 100%;color:#567C8D" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
{%- endif -%}
</main>

