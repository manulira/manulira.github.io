.sepia2 .receta-tip{margin-top:auto;background:var(--papel);border-radius:var(--r-md);padding:.75rem .9rem;font-size:.86rem;color:var(--tinta-70);line-height:1.45}
.sepia2 .receta-tip b{font-family:var(--display);color:var(--tinta)}


/* ---------- Selector de matcha ---------- */
.sepia2 .selector{display:grid;gap:clamp(.8rem,1.6vw,1.1rem);grid-template-columns:1fr}
@media(min-width:760px){.sepia2 .selector{grid-template-columns:repeat(3,1fr)}}
.sepia2 .sel-tarjeta{background:var(--blanco);border-radius:var(--r-xl);padding:clamp(1.3rem,2.4vw,1.7rem);display:flex;flex-direction:column;gap:.7rem;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
.sepia2 .sel-tarjeta:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(37,42,44,.13)}
.sepia2 .sel-etq{font-family:var(--display);font-weight:600;font-size:.74rem;letter-spacing:.07em;text-transform:uppercase;color:var(--teal)}
.sepia2 .sel-arte{width:64px;height:88px;max-width:none;--acento:var(--navy);margin:.2rem 0}
.sepia2 .sel-tarjeta h3{font-size:clamp(1.18rem,1.8vw,1.4rem)}
.sepia2 .sel-tarjeta p{font-size:.93rem;color:var(--tinta-70);line-height:1.52}
.sepia2 .sel-pie{margin-top:auto;padding-top:.5rem;display:inline-flex;align-items:center;gap:.4rem;font-family:var(--display);font-weight:600;font-size:.92rem}
.sepia2 .sel-pie .ic{width:15px;height:15px;transition:transform .25s var(--ease)}
.sepia2 .sel-tarjeta:hover .sel-pie .ic{transform:translateX(4px)}

/* ---------- Grupos de preguntas ---------- */
.sepia2 .faq-grupo{max-width:62rem;margin-inline:auto}
.sepia2 .faq-grupo+.faq-grupo{margin-top:clamp(1.6rem,3vw,2.6rem)}
.sepia2 .faq-grupo-cab{margin-bottom:.9rem;padding-left:.2rem}
.sepia2 .faq-grupo-cab h3{font-size:clamp(1.2rem,1.9vw,1.42rem)}
.sepia2 .faq-grupo-cab p{font-size:.9rem;color:var(--tinta-60);margin-top:.2rem}
.sepia2 .resp-cta{margin-top:.9rem}
.sepia2 .resp-cta a{display:inline-flex;align-items:center;gap:.4rem;font-family:var(--display);font-weight:600;font-size:.9rem;color:var(--navy);background:var(--celeste);padding:.5rem .9rem;border-radius:var(--r-pill);border-bottom:0}
.sepia2 .resp-cta a:hover{background:var(--teal);color:var(--blanco)}
.sepia2 .resp-cta .ic{width:14px;height:14px;transition:transform .25s var(--ease)}
.sepia2 .resp-cta a:hover .ic{transform:translateX(3px)}
.sepia2 .resp b{font-family:var(--display);color:var(--tinta)}

.sepia2 .sel-foto{width:64px;height:88px;object-fit:contain;max-width:none;margin:.2rem 0}
.sepia2 .prod-precio.pendiente{font-size:.95rem;color:var(--tinta-60);font-family:var(--sans);font-weight:400}

/* ---------- Cotizador de eventos ---------- */
.sepia2 .cot{display:grid;gap:clamp(1rem,2.2vw,1.6rem);grid-template-columns:1fr;align-items:start}
@media(min-width:900px){.sepia2 .cot{grid-template-columns:1.25fr .85fr}}
.sepia2 .cot-form{display:grid;gap:clamp(1.1rem,2.2vw,1.6rem);background:rgba(255,255,255,.06);border-radius:var(--r-xl);padding:clamp(1.3rem,2.6vw,2rem)}
.sepia2 .cot-campo{border:0;display:grid;gap:.6rem}
.sepia2 .cot-campo legend{font-family:var(--display);font-weight:600;font-size:.76rem;letter-spacing:.07em;text-transform:uppercase;color:var(--claro-64);padding:0;margin-bottom:.1rem}
.sepia2 .cot-chips{display:flex;flex-wrap:wrap;gap:.4rem}
.sepia2 .cot-chips button{font-family:var(--display);font-weight:600;font-size:.88rem;padding:.5rem .95rem;border-radius:var(--r-pill);background:rgba(255,255,255,.1);color:var(--papel);transition:background .2s var(--ease),color .2s var(--ease)}
.sepia2 .cot-chips button[aria-pressed="true"]{background:var(--celeste);color:var(--navy)}
.sepia2 .cot-chips button:hover[aria-pressed="false"]{background:rgba(255,255,255,.2)}
.sepia2 .cot-numero{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap}
.sepia2 .cot-numero input[type="number"]{width:5.5rem;padding:.5rem .7rem;border-radius:var(--r-md);border:0;background:var(--papel);color:var(--navy);font-family:var(--display);font-weight:600;font-size:1.05rem;text-align:center}
.sepia2 .cot-numero input[type="range"]{flex:1 1 11rem;min-width:9rem;accent-color:var(--celeste);background:transparent}
.sepia2 .cot-unidad{font-size:.88rem;color:var(--claro-64)}
.sepia2 .cot-casillas{display:grid;gap:.5rem}
.sepia2 .cot-casillas label{display:flex;gap:.65rem;align-items:flex-start;cursor:pointer;background:rgba(255,255,255,.06);border-radius:var(--r-md);padding:.7rem .85rem;transition:background .2s var(--ease)}
.sepia2 .cot-casillas label:hover{background:rgba(255,255,255,.12)}
.sepia2 .cot-casillas input{margin-top:.22rem;accent-color:var(--celeste);width:1rem;height:1rem;flex:none}
.sepia2 .cot-casillas b{font-family:var(--display);font-weight:600;font-size:.95rem;display:block}
.sepia2 .cot-casillas em{font-style:normal;font-size:.82rem;color:var(--claro-64);display:block;margin-top:.1rem}
.sepia2 .cot-carta{font-size:.88rem;color:var(--claro-64);line-height:1.5}
.sepia2 .cot-carta b{color:var(--papel);font-weight:500}
.sepia2 .cot-salida{background:var(--papel);color:var(--tinta);border-radius:var(--r-xl);padding:clamp(1.3rem,2.6vw,1.9rem);display:grid;gap:1rem}
.sepia2 .cot-salida h3{font-size:clamp(1.2rem,1.9vw,1.42rem)}
.sepia2 .cot-cifras{display:grid;gap:.1rem}
.sepia2 .cot-cifras>div{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding:.55rem 0;border-bottom:1px solid var(--tinta-14)}
.sepia2 .cot-cifras>div:last-child{border-bottom:0}
.sepia2 .cot-cifras dt{font-size:.9rem;color:var(--tinta-60)}
.sepia2 .cot-cifras dd{font-family:var(--display);font-weight:600;font-size:1.02rem;text-align:right}
.sepia2 .cot-total{background:var(--celeste);border-radius:var(--r-lg);padding:.95rem 1.1rem}
.sepia2 .cot-total-et{display:block;font-family:var(--display);font-weight:600;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--teal)}
.sepia2 .cot-total-val{display:block;font-family:var(--display);font-weight:600;font-size:clamp(1.3rem,2.4vw,1.8rem);line-height:1.1;margin-top:.2rem;color:var(--navy)}
.sepia2 .cot-nota{font-size:.82rem;color:var(--tinta-70);margin-top:.45rem;line-height:1.45}
.sepia2 .cot-letra{font-size:.78rem;color:var(--tinta-60);line-height:1.45}
.sepia2 #eventos .mod-cab .copy{color:var(--claro-64)}

</style>


{%- comment -%}
  ============================================================================
  DATOS ESTRUCTURADOS DE LA TIENDA · puntos 1, 2 y 4 del plan de IA
  ----------------------------------------------------------------------------
  Se arma solo con los datos reales de la tienda, así no queda nada
  inventado ni nada que haya que actualizar a mano. Shopify ya publica el
  Product de cada ficha; esto es lo que falta: quién es la marca.

  Activalo en "Datos estructurados de la tienda". Dejalo apagado si el tema
  ya emite un Organization propio: dos iguales se pisan.

  Los perfiles sociales (sameAs) se cargan en el ajuste "Perfiles de la
  marca", uno por línea. Es el campo que le permite a un asistente entender
  que el Instagram, la ficha de Google y la tienda son la misma marca.
  ============================================================================
{%- endcomment -%}
{%- if section.settings.ld_tienda -%}
  {%- comment -%} Un perfil por línea; limpio cada uno y descarto los vacíos. {%- endcomment -%}
  {%- assign ld_lineas = section.settings.ld_sameas | newline_to_br | split: '<br />' -%}
  {%- capture ld_perfiles -%}
    [
    {%- assign primero = true -%}
    {%- for linea in ld_lineas -%}
      {%- assign url = linea | strip_html | strip -%}
      {%- if url != blank -%}
        {%- unless primero -%},{%- endunless -%}{{ url | json }}
        {%- assign primero = false -%}
      {%- endif -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "OnlineStore"],
    "@id": {{ shop.url | append: '/#tienda' | json }},
    "name": {{ shop.name | default: "Sepia Coffee" | json }},
    "url": {{ shop.url | append: '/' | json }},
    {%- assign ld_desc = section.settings.ld_descripcion | default: shop.description | strip_html | strip_newlines -%}
    {%- if ld_desc != blank %}
    "description": {{ ld_desc | json }},
    {%- endif %}
    {%- if section.settings.ld_logo != blank %}
    "logo": {
      "@type": "ImageObject",
      "url": {{ section.settings.ld_logo | image_url: width: 600 | prepend: 'https:' | json }}
    },
    {%- endif %}
    {%- if shop.email != blank %}
    "email": {{ shop.email | json }},
    {%- endif %}
    {%- if shop.phone != blank %}
    "telephone": {{ shop.phone | json }},
    {%- endif %}
    {%- if shop.address.country != blank %}
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ shop.address.street | json }},
      "addressLocality": {{ shop.address.city | json }},
      "addressRegion": {{ shop.address.province | json }},
      "postalCode": {{ shop.address.zip | json }},
      "addressCountry": {{ shop.address.country_upper | json }}
    },
    {%- endif %}
    "areaServed": { "@type": "Country", "name": {{ section.settings.ld_pais | default: 'Chile' | json }} },
    "currenciesAccepted": {{ shop.currency | default: "CLP" | json }},
    "knowsLanguage": {{ request.locale.iso_code | default: 'es-CL' | json }},
    "sameAs": {{ ld_perfiles | strip_newlines }}
  }
  </script>
{%- endif -%}

