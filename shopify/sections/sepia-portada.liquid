                     data-precio="{{ producto.price }}" data-tono="{{ tono }}" data-acento="{{ acento }}"
                     data-arte="{{ arte }}" data-url="{{ producto.url }}">
              <a class="prod-media" href="{{ producto.url }}" style="--tono:{{ tono }}" aria-label="{{ producto.title | escape }}">
                {%- if producto.featured_image -%}
                  {{ producto.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'foto', alt: producto.title }}
                  {%- if producto.images[1] -%}
                    {{ producto.images[1] | image_url: width: 800 | image_tag: loading: 'lazy', class: 'foto alterna', alt: '' }}
                  {%- endif -%}
                {%- else -%}
                  <svg class="arte" viewBox="0 0 200 272" style="--acento:{{ acento }}"><use href="#{{ arte }}"/></svg>
                {%- endif -%}
                {%- unless producto.available -%}<span class="prod-etq">Agotado</span>
                {%- else -%}{%- if etq != blank -%}<span class="prod-etq{% if etqc != blank %} {{ etqc }}{% endif %}">{{ etq }}</span>{%- endif -%}{%- endunless -%}
              </a>
              {%- if lista_m.size > 0 -%}
                <div class="muestras">
                  {%- for m in lista_m limit: 4 -%}
                    <button class="muestra" type="button" style="--c:{{ m }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Color {{ forloop.index }}"></button>
                  {%- endfor -%}
                  {%- if lista_m.size > 4 -%}<span class="resto">+{{ lista_m.size | minus: 4 }}</span>{%- endif -%}
                </div>
              {%- endif -%}
              <div class="prod-info">
                <h3><a href="{{ producto.url }}">{{ producto.title }}</a></h3>
                {%- if sub != blank -%}<p class="prod-sub">{{ sub }}</p>{%- endif -%}
                {%- if rating != blank -%}
                {%- endif -%}
                <p class="prod-precio">{{ producto.price | money }}
                  {%- if producto.compare_at_price > producto.price -%}<span class="antes">{{ producto.compare_at_price | money }}</span>{%- endif -%}
                </p>
              </div>
              <form method="post" action="/cart/add" accept-charset="UTF-8" style="margin:0" data-agregar-form>
                <input type="hidden" name="form_type" value="product">
                <input type="hidden" name="utf8" value="✓">
                <input type="hidden" name="id" value="{{ variante.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn chico bloque" {% unless producto.available %}disabled{% endunless %}>
                  {%- if producto.available -%}Agregar{%- else -%}Agotado{%- endif -%}
                </button>
              </form>
            </article>
          {%- endfor -%}
        {%- else -%}
          <article class="prod" data-id="pack-descubrir" data-nombre="Pack Descubrir" data-precio="29900"
                   data-tono="#FFFFFF" data-acento="#2F4156" data-arte="s2-i-caja">
            <div class="prod-media" style="--tono:#FFFFFF">
              <svg class="arte" viewBox="0 0 200 272" style="--acento:#2F4156" role="img" aria-label="Pack Descubrir"><use href="#s2-i-caja"/></svg>
              <span class="prod-etq rojo">Ahorrás 16%</span>
