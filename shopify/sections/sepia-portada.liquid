          </article>
          <article class="prod" data-id="pack-regalo" data-nombre="Pack Regalo" data-precio="39900"
                   data-tono="#C8D9E6" data-acento="#2F4156" data-arte="s2-i-caja">
            <div class="prod-media" style="--tono:#C8D9E6">
