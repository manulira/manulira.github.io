  display:grid;gap:2rem;grid-template-columns:repeat(4,1fr);
}
.sepia2 .mega-col h4{font-family:var(--display);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--tinta-40);margin-bottom:1rem}
