{%- if section.settings.mostrar_anuncio and section.settings.anuncio != blank -%}
  <div class="anuncio"><a href="{{ section.settings.anuncio_url | default: '#' }}">{{ section.settings.anuncio }}</a></div>
{%- endif -%}

{%- if section.settings.mostrar_cabecera -%}
{%- assign menus = section.blocks | where: 'type', 'menu' -%}
<header class="cabecera" data-cabecera>
  <div class="cab-fila">
    <a href="{{ routes.root_url }}" class="marca" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: height: 60 | image_tag: alt: shop.name, style: 'height:32px;width:auto' }}
      {%- else -%}
        <span class="palabra" style="--cam-fondo:var(--navy)">sep<span class="cam">&#305;<svg class="cab" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20"/></svg><svg class="patas" viewBox="0 0 200 130" aria-hidden="true"><use href="#s2-i-piernas"/></svg></span>a coffee</span>
        <svg class="grano" viewBox="0 0 24 32" aria-hidden="true" style="--fondo-grano:#E8E2D7"><use href="#s2-i-grano"/></svg>
      {%- endif -%}
    </a>

    <nav aria-label="Navegación principal" style="flex:1">
      <ul class="nav-prin">
        {%- for bloque in menus -%}
          {%- assign hijos = bloque.settings.enlaces | newline_to_br | split: '<br />' -%}
          {%- if hijos.size > 1 -%}
            <li data-mega="{{ bloque.id }}">
              <button type="button" aria-expanded="false">{{ bloque.settings.titulo }}
                <svg class="ic caret" viewBox="0 0 24 24" aria-hidden="true"><use href="#s2-i-caret"/></svg></button>
            </li>
          {%- else -%}
            <li><a href="{{ bloque.settings.url | default: '#' }}">{{ bloque.settings.titulo }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="cab-acciones">
      <a class="ic-btn" href="{{ routes.search_url }}" aria-label="Buscar"><svg class="ic" viewBox="0 0 24 24"><use href="#s2-i-buscar"/></svg></a>
      <a class="ic-btn" href="{{ routes.account_url }}" aria-label="Mi cuenta"><svg class="ic" viewBox="0 0 24 24"><use href="#s2-i-usuario"/></svg></a>
      <a class="ic-btn" href="{{ routes.cart_url }}" aria-label="Carrito">
        <svg class="ic" viewBox="0 0 24 24"><use href="#s2-i-carro"/></svg>
        <span class="burbuja{% if cart.item_count > 0 %} visible{% endif %}" data-burbuja>{{ cart.item_count }}</span>
      </a>
      <button class="ic-btn hamb" type="button" data-abrir-menu aria-label="Abrir el menú" aria-expanded="false">
        <svg class="ic" viewBox="0 0 24 24"><use href="#s2-i-menu"/></svg>
      </button>
    </div>
  </div>

  {%- for bloque in menus -%}
    {%- assign hijos = bloque.settings.enlaces | newline_to_br | split: '<br />' -%}
    {%- if hijos.size > 1 -%}
      <div class="mega" data-panel="{{ bloque.id }}">
        <div class="mega-rejilla">
          {%- assign porcol = hijos.size | divided_by: 3 | plus: 1 -%}
          {%- for c in (1..3) -%}
            <div class="mega-col">
              <h4>{{ bloque.settings.titulo }}</h4>
              <ul>
                {%- for h in hijos -%}
                  {%- assign col = forloop.index0 | divided_by: porcol | plus: 1 -%}
                  {%- if col == c -%}
                    {%- assign par = h | strip | split: '|' -%}
                    {%- if par[0] != blank -%}
                      <li><a href="{{ par[1] | default: '#' | strip }}">{{ par[0] | strip }}</a></li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
          <div class="mega-destacado">
            <a class="mega-tarjeta" href="{{ bloque.settings.destacado_url | default: '#' }}" style="background:{{ bloque.settings.destacado_color }}">
              {%- if bloque.settings.destacado_imagen != blank -%}
                {{ bloque.settings.destacado_imagen | image_url: width: 800 | image_tag: loading: 'lazy', alt: '',
                   style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1' }}
              {%- endif -%}
              {%- if bloque.settings.destacado_texto != blank -%}
                <span class="etq">{{ bloque.settings.destacado_texto }}</span>
              {%- endif -%}
            </a>
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</header>
{%- endif -%}

<main>
<!-- ===================== 01 · HERO ===================== -->
{%- assign slides = section.blocks | where: 'type', 'slide' -%}
{%- if slides.size > 0 -%}
<section class="hero" data-hero aria-roledescription="carrusel" aria-label="Destacados">
  <div class="hero-pista" data-hero-pista>
    {%- for bloque in slides -%}
      <article class="hero-slide" role="group" aria-roledescription="diapositiva"
               aria-label="{{ forloop.index }} de {{ slides.size }}" {{ bloque.shopify_attributes }}>
        {%- if bloque.settings.diseno == 'partido' -%}
          <div class="hero-caja dividida" style="background:{{ bloque.settings.fondo_panel }}">
            <div class="hero-panel"><div class="interno">
              <h2 class="t-6xl">{{ bloque.settings.titulo }}</h2>
              {%- if bloque.settings.copy != blank -%}<p class="copy">{{ bloque.settings.copy }}</p>{%- endif -%}
              <div class="btns">
                {%- if bloque.settings.cta1 != blank -%}<a href="{{ bloque.settings.cta1_url | default: '#' }}" class="btn">{{ bloque.settings.cta1 }}</a>{%- endif -%}
                {%- if bloque.settings.cta2 != blank -%}<a href="{{ bloque.settings.cta2_url | default: '#' }}" class="btn linea">{{ bloque.settings.cta2 }}</a>{%- endif -%}
              </div>
            </div></div>
            <div class="hero-foto">
              {%- if bloque.settings.imagen != blank -%}
                {{ bloque.settings.imagen | image_url: width: 1400 | image_tag:
                   loading: 'eager', alt: bloque.settings.imagen.alt | default: bloque.settings.titulo }}
              {%- else -%}
                <div class="hero-arte" aria-hidden="true">
                  <span class="burbuja-deco b1"></span><span class="burbuja-deco b2"></span>
                  <svg class="pieza p1" viewBox="0 0 200 272" style="--acento:{{ bloque.settings.acento_1 }}"><use href="#s2-i-bolsa"/></svg>
                  <svg class="pieza p2" viewBox="0 0 200 272"><use href="#s2-i-tarro"/></svg>
                  <svg class="pieza p3" viewBox="0 0 200 272" style="--acento:{{ bloque.settings.acento_3 }}"><use href="#s2-i-botella"/></svg>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <div class="hero-caja" style="background:{{ bloque.settings.fondo }}">
            <div class="hero-fondo">
              {%- if bloque.settings.imagen != blank -%}
                {{ bloque.settings.imagen | image_url: width: 2400 | image_tag:
                   loading: 'eager', alt: bloque.settings.imagen.alt | default: bloque.settings.titulo }}
              {%- else -%}
                <div class="hero-arte" aria-hidden="true">
                  <span class="burbuja-deco b1"></span><span class="burbuja-deco b2"></span>
                  <svg class="pieza p1" viewBox="0 0 200 272" style="--acento:{{ bloque.settings.acento_1 }}"><use href="#s2-i-bolsa"/></svg>
                  <svg class="pieza p2" viewBox="0 0 200 272"><use href="#s2-i-tarro"/></svg>
                  <svg class="pieza p3" viewBox="0 0 200 272" style="--acento:{{ bloque.settings.acento_3 }}"><use href="#s2-i-botella"/></svg>
                </div>
              {%- endif -%}
            </div>
            <div class="hero-velo"></div>
            <div class="hero-txt"><div class="interno">
              <h2 class="t-6xl">{{ bloque.settings.titulo }}</h2>
              {%- if bloque.settings.copy != blank -%}<p class="copy">{{ bloque.settings.copy }}</p>{%- endif -%}
              <div class="btns">
                {%- if bloque.settings.cta1 != blank -%}<a href="{{ bloque.settings.cta1_url | default: '#' }}" class="btn blanco">{{ bloque.settings.cta1 }}</a>{%- endif -%}
                {%- if bloque.settings.cta2 != blank -%}<a href="{{ bloque.settings.cta2_url | default: '#' }}" class="btn linea-clara">{{ bloque.settings.cta2 }}</a>{%- endif -%}
              </div>
            </div></div>
          </div>
        {%- endif -%}
