              <p class="prod-precio">$29.900 <span class="antes">$35.700</span></p>
            </div>
          </article>
          <article class="prod" data-id="pack-ritual" data-nombre="Pack Ritual" data-precio="22900"
                   data-tono="#C8D9E6" data-acento="#2F4156" data-arte="s2-i-taza">
            <div class="prod-media" style="--tono:#C8D9E6">
