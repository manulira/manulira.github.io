<!-- ===================== 05 · COTIZADOR DE EVENTOS =====================
     Calcula en vivo las cantidades (tragos, baristas, café, leche) a partir
     de invitados y horas. Esas cuentas son reales y no dependen de nadie.

     El precio sale de la tabla TARIFAS del script del final. Mientras esté
     en null, muestra el desglose de cantidades y ofrece pedir el valor, en
     vez de inventar una cifra. -->
<section class="modulo" id="eventos" style="background:{{ section.settings.cot_fondo }};color:var(--papel)">
  <div class="wrap">
    <div class="mod-cab rev">
      <div>
        <h2 class="t-3xl">{{ section.settings.cot_titulo }}</h2>
        <p class="copy" style="color:var(--claro-64)">{{ section.settings.cot_copy }}</p>
      </div>
    </div>

    <div class="cot rev">
      <!-- ---------- Controles ---------- -->
      <div class="cot-form">
        <fieldset class="cot-campo">
          <legend>Qué servicio</legend>
          <div class="cot-chips" role="group" data-cot="servicio">
            <button type="button" data-val="barra" aria-pressed="true">Barra de café</button>
            <button type="button" data-val="cocteles" aria-pressed="false">Espresso martini y carajillo</button>
            <button type="button" data-val="ambos" aria-pressed="false">Las dos</button>
          </div>
        </fieldset>

        <fieldset class="cot-campo">
          <legend><label for="cot-personas-{{ section.id }}">Cuántos invitados</label></legend>
          <div class="cot-numero">
            <input type="range" id="cot-personas-{{ section.id }}-r" min="20" max="400" step="10" value="80" aria-hidden="true" tabindex="-1">
            <input type="number" id="cot-personas-{{ section.id }}" min="1" max="2000" step="1" value="80" inputmode="numeric">
            <span class="cot-unidad">personas</span>
          </div>
        </fieldset>

        <fieldset class="cot-campo">
          <legend><label for="cot-horas">Cuántas horas de servicio</label></legend>
          <div class="cot-chips" role="group" data-cot="horas">
            <button type="button" data-val="2" aria-pressed="false">2 h</button>
            <button type="button" data-val="3" aria-pressed="true">3 h</button>
            <button type="button" data-val="4" aria-pressed="false">4 h</button>
            <button type="button" data-val="5" aria-pressed="false">5 h</button>
          </div>
        </fieldset>

        <fieldset class="cot-campo" data-solo-barra>
          <legend>Agregados a la barra</legend>
          <div class="cot-casillas">
            <label><input type="checkbox" data-agregado="iced"> <span><b>Iced coffee</b><em>Café helado, en vaso alto</em></span></label>
            <label><input type="checkbox" data-agregado="coldfoam"> <span><b>Cold brew con cold foam</b><em>Extraído en frío, con espuma fría encima</em></span></label>
          </div>
        </fieldset>

        <p class="cot-carta" data-solo-barra>La barra incluye <b>espresso, americano, capuccino y latte</b>, preparados al momento.</p>
        <p class="cot-carta" data-solo-cocteles hidden>La barra incluye <b>espresso martini y carajillo</b>, los dos con espresso recién extraído.</p>
      </div>

      <!-- ---------- Resultado en vivo ---------- -->
      <div class="cot-salida" aria-live="polite">
        <h3>Tu evento</h3>
        <dl class="cot-cifras">
          <div><dt>Tragos estimados</dt><dd data-cot-tragos>—</dd></div>
          <div><dt>Baristas</dt><dd data-cot-baristas>—</dd></div>
          <div><dt>Café</dt><dd data-cot-cafe>—</dd></div>
          <div data-cot-fila-leche><dt>Leche</dt><dd data-cot-leche>—</dd></div>
        </dl>

        <div class="cot-total">
          <span class="cot-total-et">Total estimado</span>
          <span class="cot-total-val" data-cot-total>Te lo confirmamos</span>
          <p class="cot-nota" data-cot-nota>Todavía no publicamos las tarifas. Pídenos el valor y te respondemos con la cotización firme.</p>
        </div>

        <a class="btn bloque" href="#" data-cot-pedir>{{ section.settings.cot_cta }}</a>
        <p class="cot-letra">Las cantidades son estimadas, calculadas sobre un consumo habitual. La cotización firme va por escrito.</p>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<!-- ===================== 06 · RESEÑAS DE GOOGLE ===================== -->
{%- assign resenas = section.blocks | where: 'type', 'resena' -%}
{%- if section.settings.g_puntaje != blank and resenas.size > 0 -%}
{%- assign llenas = section.settings.g_puntaje | replace: ',', '.' | times: 1 | round -%}
<section class="modulo" id="resenas" style="background:{{ section.settings.testi_fondo }}">
  <div class="wrap">
    <div class="mod-cab rev">
      <div>
        <h2 class="t-3xl">{{ section.settings.testi_titulo }}</h2>
        <div class="google-resumen">
          <span class="puntaje">{{ section.settings.g_puntaje }}</span>
          <span class="estrellas" role="img" aria-label="{{ section.settings.g_puntaje }} de 5">
            {%- for i in (1..5) -%}
              {%- if i <= llenas -%}<svg viewBox="0 0 24 24"><use href="#s2-i-estrella"/></svg>{%- endif -%}
            {%- endfor -%}
          </span>
          {%- if section.settings.g_conteo != blank -%}<span class="conteo">{{ section.settings.g_conteo }}</span>{%- endif -%}
          {%- if section.settings.g_enlace != blank -%}
            <a class="enlace-sub" href="{{ section.settings.g_enlace }}" target="_blank" rel="noopener">Ver en Google</a>
          {%- endif -%}
        </div>
      </div>
      <div class="car-nav" data-nav-de="resenas">
        <button type="button" data-dir="-1" aria-label="Anterior"><svg class="ic" viewBox="0 0 24 24"><use href="#s2-i-izq"/></svg></button>
        <button type="button" data-dir="1" aria-label="Siguiente"><svg class="ic" viewBox="0 0 24 24"><use href="#s2-i-der"/></svg></button>
      </div>
    </div>
    <div class="car">
      <div class="car-pista rev" data-pista="resenas">
        {%- for bloque in resenas -%}
          <div class="testi" style="--tono:{% cycle 'tono2': '#FFFFFF', '#E8E2D7' %}" {{ bloque.shopify_attributes }}>
            <span class="estrellas" role="img" aria-label="5 de 5">
              {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><use href="#s2-i-estrella"/></svg>{%- endfor -%}
            </span>
            <blockquote>{{ bloque.settings.texto }}</blockquote>
            <p class="quien">
              <span class="avatar">{{ bloque.settings.nombre | slice: 0 | upcase }}</span>
              <span><b>{{ bloque.settings.nombre }}</b><br><span>{{ bloque.settings.fecha }}</span></span>
            </p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<!-- ===================== 06 · MATCHA =====================
     El selector por uso resuelve la compra en un clic, y la comparativa
     con el café responde la pregunta de entrada de casi todo el que llega
     al matcha desde el café.

     Las cifras de cafeína son rangos de referencia. Nada de afirmaciones
     de salud sin respaldo: un asistente no las cita y a la marca le restan. -->
{%- assign sel = section.blocks | where: 'type', 'selector' -%}
{%- assign filas_m = section.blocks | where: 'type', 'fila_matcha' -%}
{%- if section.settings.mat_titulo != blank and sel.size > 0 or filas_m.size > 0 -%}
<section class="modulo" id="matcha" style="background:{{ section.settings.mat_fondo }}">
  <div class="wrap">
    {%- if section.settings.mat_titulo != blank -%}
    <div class="mod-cab rev">
      <div>
        <h2 class="t-3xl">{{ section.settings.mat_titulo }}</h2>
        {%- if section.settings.mat_copy != blank -%}<p class="copy">{{ section.settings.mat_copy }}</p>{%- endif -%}
      </div>
      {%- if section.settings.mat_cta != blank -%}
        <a href="{{ section.settings.mat_url | default: '#preguntas' }}" class="enlace-sub">{{ section.settings.mat_cta }}</a>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- if sel.size > 0 -%}
    <div class="selector rev">
      {%- for b in sel -%}
        {%- assign p = b.settings.producto -%}
        <a class="sel-tarjeta" href="{%- if p != blank -%}{{ p.url }}{%- else -%}{{ b.settings.enlace | default: '#' }}{%- endif -%}" {{ b.shopify_attributes }}>
          {%- if b.settings.etiqueta != blank -%}<span class="sel-etq">{{ b.settings.etiqueta }}</span>{%- endif -%}
          {%- if b.settings.foto != blank -%}
            {{ b.settings.foto | image_url: width: 240 | image_tag: loading: 'lazy', class: 'sel-foto', alt: b.settings.titulo }}
          {%- else -%}
            <svg class="sel-arte" viewBox="0 0 200 272" aria-hidden="true"><use href="#s2-i-{{ b.settings.arte | default: 'tarro' }}"/></svg>
          {%- endif -%}
          <h3>{%- if p != blank -%}{{ p.title }}{%- else -%}{{ b.settings.titulo }}{%- endif -%}</h3>
          {%- if b.settings.texto != blank -%}<p>{{ b.settings.texto }}</p>{%- endif -%}
          <span class="sel-pie">
            {%- if p != blank -%}Desde {{ p.price | money }}{%- else -%}{{ b.settings.precio }}{%- endif -%}
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#s2-i-der"/></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if filas_m.size > 0 and section.settings.mat_tabla_titulo != blank -%}
    <div class="panel rev" style="padding:clamp(1.3rem,2.6vw,2rem);margin-top:clamp(1rem,2vw,1.5rem)">
      <h3 class="t-2xl" style="margin-bottom:.4rem">{{ section.settings.mat_tabla_titulo }}</h3>
      {%- if section.settings.mat_tabla_copy != blank -%}
        <p class="copy" style="color:var(--tinta-60);margin-bottom:1.2rem">{{ section.settings.mat_tabla_copy }}</p>
      {%- endif -%}
      <div class="guia">
        <table>
          {%- if section.settings.mat_leyenda != blank -%}<caption>{{ section.settings.mat_leyenda }}</caption>{%- endif -%}
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              <th scope="col">{{ section.settings.mat_col_a }}</th>
              <th scope="col">{{ section.settings.mat_col_b }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for b in filas_m -%}
              <tr {{ b.shopify_attributes }}>
                <th scope="row">{{ b.settings.concepto }}</th>
                <td data-etq="{{ section.settings.mat_col_a | escape }}">{{ b.settings.lado_a }}</td>
                <td data-etq="{{ section.settings.mat_col_b | escape }}">{{ b.settings.lado_b }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if section.settings.mat_tabla_pie != blank -%}
        <p class="guia-pie">{{ section.settings.mat_tabla_pie }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<!-- ===================== 07 · GUÍA COMPARATIVA =====================
     Punto 10 del plan de IA: una comparativa útil. Es el formato que
     ChatGPT cita casi textual cuando alguien pregunta "cuál me conviene".
     Las filas son bloques "Fila de la comparativa". -->
{%- assign filas = section.blocks | where: 'type', 'comparar' -%}
{%- if filas.size > 0 and section.settings.comp_titulo != blank -%}
<section class="modulo" id="comparar">
  <div class="wrap">
    <div class="mod-cab rev">
      <div>
        <h2 class="t-3xl">{{ section.settings.comp_titulo }}</h2>
        {%- if section.settings.comp_copy != blank -%}<p class="copy">{{ section.settings.comp_copy }}</p>{%- endif -%}
      </div>
      {%- if section.settings.comp_cta != blank -%}
        <a href="{{ section.settings.comp_url | default: '/collections/all' }}" class="enlace-sub">{{ section.settings.comp_cta }}</a>
      {%- endif -%}
    </div>
    <div class="panel rev" style="padding:clamp(1.2rem,2.6vw,2rem)">
      <div class="guia">
        <table>
          {%- if section.settings.comp_leyenda != blank -%}
            <caption>{{ section.settings.comp_leyenda }}</caption>
          {%- endif -%}
          <thead>
            <tr>
              <th scope="col">{{ section.settings.comp_col1 }}</th>
              <th scope="col">{{ section.settings.comp_col2 }}</th>
              <th scope="col">{{ section.settings.comp_col3 }}</th>
              <th scope="col">{{ section.settings.comp_col4 }}</th>
              <th scope="col">{{ section.settings.comp_col5 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for b in filas -%}
              {%- assign p = b.settings.producto -%}
              <tr {{ b.shopify_attributes }}>
                <th scope="row">
                  {%- if p != blank -%}{{ p.title }}{%- else -%}{{ b.settings.nombre }}{%- endif -%}
                  {%- if b.settings.etiqueta != blank -%} <span class="pildora">{{ b.settings.etiqueta }}</span>{%- endif -%}
                </th>
                <td data-etq="{{ section.settings.comp_col2 | escape }}">{{ b.settings.que_es }}</td>
                <td data-etq="{{ section.settings.comp_col3 | escape }}">{{ b.settings.preparacion }}</td>
                <td data-etq="{{ section.settings.comp_col4 | escape }}">{{ b.settings.para_quien }}</td>
                <td data-etq="{{ section.settings.comp_col5 | escape }}" class="precio">
                  {%- if p != blank -%}{{ p.price | money }}{%- else -%}{{ b.settings.precio }}{%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if section.settings.comp_pie != blank -%}
        <p class="guia-pie">{{ section.settings.comp_pie }}</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- ===================== 08 · RECETAS =====================
     Punto 5 del plan de IA: contenido útil. Cada receta va también como
     schema.org/Recipe: es de los formatos que más citan los asistentes
     cuando alguien pregunta cómo preparar algo. -->
{%- assign recetas = section.blocks | where: 'type', 'receta' -%}
{%- if recetas.size > 0 and section.settings.rec_titulo != blank -%}
<section class="modulo" id="recetas">
  <div class="wrap">
    <div class="mod-cab rev">
      <div>
        <h2 class="t-3xl">{{ section.settings.rec_titulo }}</h2>
        {%- if section.settings.rec_copy != blank -%}<p class="copy">{{ section.settings.rec_copy }}</p>{%- endif -%}
      </div>
      {%- if section.settings.rec_cta != blank -%}
        <a href="{{ section.settings.rec_url | default: '#preguntas' }}" class="enlace-sub">{{ section.settings.rec_cta }}</a>
      {%- endif -%}
    </div>
    <div class="recetas rev">
      {%- for b in recetas -%}
        {%- assign ingr = b.settings.ingredientes | newline_to_br | split: '<br />' -%}
        {%- assign pasos = b.settings.pasos | newline_to_br | split: '<br />' -%}
        <article class="receta" id="receta-{{ b.id }}" {{ b.shopify_attributes }}>
          <div class="receta-cab">
            {%- if b.settings.foto != blank -%}
              {{ b.settings.foto | image_url: width: 160 | image_tag: loading: 'lazy', class: 'receta-foto', alt: b.settings.titulo }}
            {%- else -%}
              <svg class="receta-arte" viewBox="0 0 200 272" aria-hidden="true"><use href="#s2-i-{{ b.settings.arte | default: 'tarro' }}"/></svg>
            {%- endif -%}
            <div>
              <h3>{{ b.settings.titulo }}</h3>
              <p class="receta-meta">
                {%- if b.settings.minutos > 0 -%}<span>{{ b.settings.minutos }} min</span>{%- endif -%}
                {%- if b.settings.rinde != blank -%}<span>{{ b.settings.rinde }}</span>{%- endif -%}
              </p>
            </div>
          </div>
          {%- if b.settings.bajada != blank -%}
            <p class="receta-bajada">{{ b.settings.bajada }}</p>
          {%- endif -%}
          <div class="receta-cuerpo">
            <div class="receta-ingr">
              <h4>{{ section.settings.rec_et_ingr }}</h4>
              <ul>
                {%- for i in ingr -%}
                  {%- assign t = i | strip_html | strip -%}
                  {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
              {%- if b.settings.producto != blank -%}
                <p class="receta-prod">Con <a href="{{ b.settings.producto.url }}">{{ b.settings.producto.title }}</a></p>
              {%- endif -%}
            </div>
            <div class="receta-pasos">
              <h4>{{ section.settings.rec_et_pasos }}</h4>
              <ol>
                {%- for p in pasos -%}
                  {%- assign t = p | strip_html | strip -%}
                  {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
                {%- endfor -%}
              </ol>
            </div>
          </div>
          {%- if b.settings.dato != blank -%}
            <p class="receta-tip"><b>{{ section.settings.rec_et_dato }}</b> {{ b.settings.dato }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} Las mismas recetas, como datos estructurados. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {%- for b in recetas -%}
      {%- assign ingr = b.settings.ingredientes | newline_to_br | split: '<br />' -%}
      {%- assign pasos = b.settings.pasos | newline_to_br | split: '<br />' -%}
      {
        "@type": "Recipe",
        "@id": {{ shop.url | append: '/#receta-' | append: b.id | json }},
        "name": {{ b.settings.titulo | strip_html | json }},
        {%- if b.settings.bajada != blank %}
        "description": {{ b.settings.bajada | strip_html | strip_newlines | json }},
        {%- endif %}
        "inLanguage": {{ request.locale.iso_code | default: 'es-CL' | json }},
        "author": { "@id": {{ shop.url | append: '/#tienda' | json }} },
        {%- if b.settings.minutos > 0 %}
        "totalTime": "PT{{ b.settings.minutos }}M",
        {%- endif %}
        {%- if b.settings.rinde != blank %}
        "recipeYield": {{ b.settings.rinde | json }},
        {%- endif %}
        "recipeCategory": "Bebida",
        "recipeIngredient": [
          {%- assign primero = true -%}
          {%- for i in ingr -%}
            {%- assign t = i | strip_html | strip -%}
            {%- if t != blank -%}
              {%- unless primero -%},{%- endunless -%}{{ t | json }}
              {%- assign primero = false -%}
            {%- endif -%}
          {%- endfor -%}
        ],
        "recipeInstructions": [
          {%- assign n = 0 -%}
          {%- for p in pasos -%}
            {%- assign t = p | strip_html | strip -%}
            {%- if t != blank -%}
              {%- if n > 0 -%},{%- endif -%}
              {%- assign n = n | plus: 1 -%}
              { "@type": "HowToStep", "position": {{ n }}, "text": {{ t | json }} }
            {%- endif -%}
          {%- endfor -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<!-- ===================== 08 · BLOQUE EDITORIAL ===================== -->
{%- if section.settings.edi_titulo != blank -%}
<section class="modulo" id="nosotros">
  <div class="wrap">
    <div class="editorial rev">
      <div class="editorial-rejilla">
        <div>
          <h2 class="t-4xl">{{ section.settings.edi_titulo }}</h2>
          <div>{{ section.settings.edi_texto }}</div>
          {%- if section.settings.edi_cta != blank -%}
            <a href="{{ section.settings.edi_url | default: '#' }}" class="btn blanco">{{ section.settings.edi_cta }}</a>
          {%- endif -%}
        </div>
        <div class="editorial-fotos">
          <div>
            {%- if section.settings.edi_img1 != blank -%}
              {{ section.settings.edi_img1 | image_url: width: 800 | image_tag: loading: 'lazy', class: 'foto', alt: '' }}
            {%- else -%}
              <svg viewBox="0 0 200 272" style="--acento:#AEBFC2" aria-hidden="true"><use href="#s2-i-bolsa"/></svg>
            {%- endif -%}
          </div>
          <div>
            {%- if section.settings.edi_img2 != blank -%}
              {{ section.settings.edi_img2 | image_url: width: 800 | image_tag: loading: 'lazy', class: 'foto', alt: '' }}
            {%- else -%}
              <svg viewBox="0 0 200 272" style="--acento:#AEBFC2" aria-hidden="true"><use href="#s2-i-tarro"/></svg>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<!-- ===================== 09 · PREGUNTAS FRECUENTES =====================
     Criterio: estas son las preguntas que la gente le hace a ChatGPT sobre
     matcha y café, no las que una marca querría que le hicieran. Las que
     dan pie a una compra cierran con una oferta.

     Donde la respuesta honesta no favorece la venta, va la respuesta
     honesta igual: un asistente no cita afirmaciones de salud sin respaldo. -->
{%- assign preguntas = section.blocks | where: 'type', 'pregunta' -%}
{%- if preguntas.size > 0 and section.settings.faq_titulo != blank -%}
<section class="modulo" id="preguntas">
  <div class="wrap">
    <div class="mod-cab rev" style="justify-content:center;text-align:center">
      <div>
        <h2 class="t-3xl">{{ section.settings.faq_titulo }}</h2>
        {%- if section.settings.faq_copy != blank -%}
          <p class="copy" style="margin-inline:auto">{{ section.settings.faq_copy }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Agrupadas, en el orden en que aparecen los grupos. {%- endcomment -%}
    {%- assign vistos = '' -%}
    {%- for b in preguntas -%}
      {%- assign g = b.settings.grupo | default: 'otras' -%}
      {%- unless vistos contains g -%}
        {%- assign vistos = vistos | append: g | append: ',' -%}
        {%- assign delgrupo = preguntas | where: 'settings.grupo', g -%}
        <div class="faq-grupo rev">
          {%- if b.settings.grupo_titulo != blank -%}
            <div class="faq-grupo-cab">
              <h3 class="t-xl">{{ b.settings.grupo_titulo }}</h3>
              {%- if b.settings.grupo_bajada != blank -%}<p>{{ b.settings.grupo_bajada }}</p>{%- endif -%}
            </div>
          {%- endif -%}
          <div class="faq">
            {%- for q in delgrupo -%}
              <details {{ q.shopify_attributes }}>
                <summary>{{ q.settings.pregunta }}</summary>
                <div class="resp">
                  {{ q.settings.respuesta }}
                  {%- if q.settings.cta_texto != blank -%}
                    <p class="resp-cta">
                      <a href="{%- if q.settings.cta_producto != blank -%}{{ q.settings.cta_producto.url }}{%- else -%}{{ q.settings.cta_url | default: '#' }}{%- endif -%}">
                        {{ q.settings.cta_texto }}
                        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#s2-i-der"/></svg>
                      </a>
                    </p>
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} El mismo texto, como datos estructurados. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": {{ request.locale.iso_code | default: 'es-CL' | json }},
  "mainEntity": [
    {%- for b in preguntas -%}
      {
        "@type": "Question",
        "name": {{ b.settings.pregunta | strip_html | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ b.settings.respuesta | strip_html | strip_newlines | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
<!-- ===================== BOLETÍN ===================== -->
{%- if section.settings.mostrar_boletin -%}
<section class="modulo sin-top" id="boletin">
  <div class="wrap">
    <div class="boletin rev" style="background:{{ section.settings.bol_fondo }}">
      <h2 class="t-3xl">{{ section.settings.bol_titulo }}</h2>
      {%- if section.settings.bol_copy != blank -%}<p class="copy">{{ section.settings.bol_copy }}</p>{%- endif -%}
      {%- form 'customer', class: 'form-bol' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="correo-{{ section.id }}" class="solo-lectores">Tu correo</label>
        <input type="email" id="correo-{{ section.id }}" name="contact[email]" required autocomplete="email"
               placeholder="{{ section.settings.bol_placeholder }}" value="{{ form.email }}">
        <button class="btn" type="submit">{{ section.settings.bol_cta }}</button>
        {%- if form.posted_successfully? -%}
          <p class="bol-ok visible" style="flex:1 1 100%" role="status">{{ section.settings.bol_gracias }}</p>
        {%- elsif form.errors -%}
          <p class="bol-ok visible" style="flex:1 1 100%;color:#706962" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
{%- endif -%}
</main>

<!-- ===================== PIE ===================== -->
{%- assign cols = section.blocks | where: 'type', 'pie_col' -%}
{%- if section.settings.mostrar_pie and cols.size > 0 -%}
<footer class="pie">
  <div class="wrap">
    <div class="pie-top">
      <div class="pie-marca">
        <span class="palabra" style="--cam-fondo:var(--navy)">sep<span class="cam">&#305;<svg class="cab" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20"/></svg><svg class="patas" viewBox="0 0 200 130" aria-hidden="true"><use href="#s2-i-piernas"/></svg></span>a coffee</span>
        {%- if section.settings.pie_texto != blank -%}<p>{{ section.settings.pie_texto }}</p>{%- endif -%}
        <div class="redes">
          {%- if section.settings.ig != blank -%}<a href="{{ section.settings.ig }}" aria-label="Instagram"><svg viewBox="0 0 24 24"><use href="#s2-i-ig"/></svg></a>{%- endif -%}
          {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" aria-label="TikTok"><svg viewBox="0 0 24 24"><use href="#s2-i-tiktok"/></svg></a>{%- endif -%}
          {%- if section.settings.wsp != blank -%}<a href="{{ section.settings.wsp }}" aria-label="WhatsApp"><svg viewBox="0 0 24 24"><use href="#s2-i-wsp"/></svg></a>{%- endif -%}
        </div>
      </div>
      {%- for bloque in cols -%}
        <div class="pie-col" data-acordeon {{ bloque.shopify_attributes }}>
          <button type="button" aria-expanded="false">{{ bloque.settings.titulo }}
            <svg class="ic caret" viewBox="0 0 24 24" aria-hidden="true"><use href="#s2-i-caret"/></svg></button>
          <ul>
            {%- assign filas = bloque.settings.enlaces | newline_to_br | split: '<br />' -%}
            {%- for f in filas -%}
              {%- assign par = f | strip | split: '|' -%}
              {%- if par[0] != blank -%}<li><a href="{{ par[1] | default: '#' | strip }}">{{ par[0] | strip }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="pie-abajo">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.pie_legal }}</span>
      <div class="pagos">
        {%- for tipo in shop.enabled_payment_types limit: 5 -%}
          <span class="pago">{{ tipo }}</span>
        {%- else -%}
          <span class="pago">Webpay</span><span class="pago">Mercado Pago</span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>
{%- endif -%}

<!-- ===================== MENÚ MÓVIL ===================== -->
{%- if section.settings.mostrar_cabecera -%}
<div class="velo" data-velo hidden></div>
<aside class="lateral izq" data-panel-menu aria-label="Menú" aria-hidden="true">
  <div class="lat-cab">
    <span class="marca"><span class="palabra" style="--cam-fondo:var(--papel)">sep<span class="cam">&#305;<svg class="cab" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20"/></svg><svg class="patas" viewBox="0 0 200 130" aria-hidden="true"><use href="#s2-i-piernas"/></svg></span>a coffee</span></span>
    <button class="ic-btn" type="button" data-cerrar aria-label="Cerrar"><svg class="ic" viewBox="0 0 24 24"><use href="#s2-i-cerrar"/></svg></button>
  </div>
  <div class="lat-cuerpo">
    <ul class="nav-movil">
      {%- for bloque in menus -%}
        {%- assign hijos = bloque.settings.enlaces | newline_to_br | split: '<br />' -%}
        {%- if hijos.size > 1 -%}
          <li data-acordeon>
            <button type="button" aria-expanded="false">{{ bloque.settings.titulo }}
              <svg class="ic caret" viewBox="0 0 24 24" aria-hidden="true"><use href="#s2-i-caret"/></svg></button>
            <div class="sub">
              {%- for h in hijos -%}
                {%- assign par = h | strip | split: '|' -%}
                {%- if par[0] != blank -%}<a href="{{ par[1] | default: '#' | strip }}">{{ par[0] | strip }}</a>{%- endif -%}
              {%- endfor -%}
            </div>
          </li>
        {%- else -%}
          <li><a href="{{ bloque.settings.url | default: '#' }}">{{ bloque.settings.titulo }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
  <div class="lat-pie">
    <a href="{{ routes.all_products_collection_url }}" class="btn bloque" data-cerrar>Ver todo</a>
  </div>
</aside>
{%- endif -%}

</div>

<script>
(function(){
  "use strict";
  var ID = "{{ section.id }}";

  function iniciar(){
    var raiz = document.querySelector('[data-sepia2="' + ID + '"]');
    if(!raiz || raiz.dataset.listo === "1") return;
    raiz.dataset.listo = "1";
    var $  = function(s){ return raiz.querySelector(s); };
    var $$ = function(s){ return Array.prototype.slice.call(raiz.querySelectorAll(s)); };
    var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* Revelados */
    if("IntersectionObserver" in window && !quieto){
      var obs = new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add("visto"); obs.unobserve(e.target); } });
      },{ threshold:.08, rootMargin:"0px 0px -6% 0px" });
      $$(".rev").forEach(function(el){ obs.observe(el); });
    } else { $$(".rev").forEach(function(el){ el.classList.add("visto"); }); }

    /* Cabecera */
    var cab = $("[data-cabecera]"), tick = false;
    if(cab) window.addEventListener("scroll", function(){
      if(tick) return; tick = true;
      window.requestAnimationFrame(function(){ cab.classList.toggle("pegada",(window.pageYOffset||0)>8); tick=false; });
    },{passive:true});

    /* Mega menú */
    var megas = $$(".nav-prin li[data-mega]"), timer = null;
    function abrirMega(li){
      clearTimeout(timer);
      megas.forEach(function(o){
        var act = o === li;
        o.toggleAttribute("data-abierto", act);
        var b = o.querySelector("button"); if(b) b.setAttribute("aria-expanded", String(act));
        var pn = $('.mega[data-panel="' + o.dataset.mega + '"]');
        if(pn) pn.toggleAttribute("data-visible", act);
      });
    }
    function cerrarMega(){
      megas.forEach(function(o){
        o.removeAttribute("data-abierto");
        var b = o.querySelector("button"); if(b) b.setAttribute("aria-expanded","false");
        var pn = $('.mega[data-panel="' + o.dataset.mega + '"]');
        if(pn) pn.removeAttribute("data-visible");
      });
    }
    function diferido(){ clearTimeout(timer); timer = setTimeout(cerrarMega, 160); }
    megas.forEach(function(li){
      var pn = $('.mega[data-panel="' + li.dataset.mega + '"]');
      li.addEventListener("mouseenter", function(){ abrirMega(li); });
      li.addEventListener("mouseleave", diferido);
      if(pn){ pn.addEventListener("mouseenter", function(){ clearTimeout(timer); }); pn.addEventListener("mouseleave", diferido); }
      var b = li.querySelector("button");
      if(b) b.addEventListener("click", function(){ li.hasAttribute("data-abierto") ? cerrarMega() : abrirMega(li); });
    });
    document.addEventListener("keydown", function(e){ if(e.key === "Escape") cerrarMega(); });

    /* Hero */
    var pista = $("[data-hero-pista]");
    if(pista){
      var slides = Array.prototype.slice.call(pista.children),
          puntos = $("[data-hero-puntos]"), actual = 0, auto = null;
      if(puntos){
        puntos.innerHTML = slides.map(function(_,i){
          return '<button type="button" role="tab" aria-label="Diapositiva ' + (i+1) + '" aria-current="' + (i===0) + '"></button>';
        }).join("");
      }
      var bps = puntos ? Array.prototype.slice.call(puntos.children) : [];
      function irA(i){
        actual = (i + slides.length) % slides.length;
        pista.style.transform = "translateX(" + (-actual*100) + "%)";
        bps.forEach(function(b,k){ b.setAttribute("aria-current", String(k===actual)); });
        slides.forEach(function(s,k){ s.setAttribute("aria-hidden", String(k!==actual)); });
      }
      function arrancar(){ if(quieto || slides.length < 2) return; detener(); auto = setInterval(function(){ irA(actual+1); }, 4000); }
      function detener(){ if(auto) clearInterval(auto); auto = null; }
      bps.forEach(function(b,i){ b.addEventListener("click", function(){ irA(i); arrancar(); }); });
      var iz = $(".hero-flecha.izq"), de = $(".hero-flecha.der");
      if(iz) iz.addEventListener("click", function(){ irA(actual-1); arrancar(); });
      if(de) de.addEventListener("click", function(){ irA(actual+1); arrancar(); });
      var hero = $("[data-hero]"), x0 = null;
      hero.addEventListener("mouseenter", detener);
      hero.addEventListener("mouseleave", arrancar);
      hero.addEventListener("touchstart", function(e){ x0 = e.touches[0].clientX; detener(); },{passive:true});
      hero.addEventListener("touchend", function(e){
        if(x0 === null) return;
        var d = e.changedTouches[0].clientX - x0;
        if(Math.abs(d) > 45) irA(actual + (d < 0 ? 1 : -1));
        x0 = null; arrancar();
      },{passive:true});
      irA(0); arrancar();
    }

    /* Cinta de ventajas */
    var usp = $("[data-usp-pista]");
    if(usp){
      var textos = (usp.parentNode.dataset.usp || "").split(",").map(function(t){ return t.trim(); }).filter(Boolean);
      if(textos.length){
        var g = '<span class="usp-grupo">' + textos.map(function(t){
          return '<span class="usp-item">' + t + '</span><span class="usp-sep"></span>';
        }).join("") + '</span>';
        usp.innerHTML = g + g;
      }
    }

    /* Carruseles */
    $$(".car-nav").forEach(function(nav){
      var p = $('[data-pista="' + nav.dataset.navDe + '"]');
      if(!p) return;
      var btns = Array.prototype.slice.call(nav.querySelectorAll("button"));
      function paso(){ var t = p.firstElementChild; return t ? t.getBoundingClientRect().width + 16 : 320; }
      function estado(){
        var max = p.scrollWidth - p.clientWidth - 2;
        btns[0].disabled = p.scrollLeft <= 2;
        btns[1].disabled = p.scrollLeft >= max;
      }
      btns.forEach(function(b){
        b.addEventListener("click", function(){
          p.scrollBy({ left: paso() * parseInt(b.dataset.dir,10), behavior: quieto ? "auto" : "smooth" });
        });
      });
      p.addEventListener("scroll", estado, {passive:true});
      window.addEventListener("resize", estado);
      estado();
    });

    /* Muestras de color */
    $$(".muestras").forEach(function(g){
      var ms = Array.prototype.slice.call(g.querySelectorAll(".muestra"));
      ms.forEach(function(m){
        m.addEventListener("click", function(){
          ms.forEach(function(o){ o.setAttribute("aria-pressed", String(o === m)); });
          var ficha = m.closest(".prod"), arte = ficha && ficha.querySelector(".arte");
          if(arte) arte.style.setProperty("--acento", getComputedStyle(m).getPropertyValue("--c"));
        });
      });
    });

    /* Agregar al carrito sin recargar */
    var burbujas = $$("[data-burbuja]");
    function refrescar(){
      fetch("/cart.js", { headers:{ Accept:"application/json" } })
        .then(function(r){ return r.json(); })
        .then(function(c){
          burbujas.forEach(function(b){ b.textContent = c.item_count; b.classList.toggle("visible", c.item_count > 0); });
          document.dispatchEvent(new CustomEvent("sepia:carrito", { detail:c }));
        }).catch(function(){});
    }
    $$("[data-agregar-form]").forEach(function(form){
      form.addEventListener("submit", function(e){
        if(!window.fetch) return;
        e.preventDefault();
        var btn = form.querySelector("button"), txt = btn.textContent;
        btn.disabled = true;
        fetch("/cart/add.js", { method:"POST", headers:{ Accept:"application/json" }, body:new FormData(form) })
          .then(function(r){ if(!r.ok) throw new Error("no"); 
            btn.disabled = false; btn.textContent = "Agregado";
            setTimeout(function(){ btn.textContent = txt; }, 1600); refrescar(); })
          .catch(function(){ btn.disabled = false; form.submit(); });
      });
    });

    /* Panel lateral y acordeones */
    var velo = $("[data-velo]"), panelMenu = $("[data-panel-menu]"), abre = $("[data-abrir-menu]");
    function abrir(){
      if(!panelMenu) return;
      velo.hidden = false;
      requestAnimationFrame(function(){ velo.classList.add("abierto"); panelMenu.classList.add("abierto"); });
      panelMenu.setAttribute("aria-hidden","false");
      document.body.style.overflow = "hidden";
      if(abre) abre.setAttribute("aria-expanded","true");
    }
    function cerrar(){
      if(!panelMenu || !panelMenu.classList.contains("abierto")) return;
      panelMenu.classList.remove("abierto");
      panelMenu.setAttribute("aria-hidden","true");
      velo.classList.remove("abierto");
      document.body.style.overflow = "";
      if(abre) abre.setAttribute("aria-expanded","false");
      setTimeout(function(){ velo.hidden = true; }, 440);
    }
    if(abre) abre.addEventListener("click", abrir);
    if(velo) velo.addEventListener("click", cerrar);
    raiz.addEventListener("click", function(e){ if(e.target.closest && e.target.closest("[data-cerrar]")) cerrar(); });
    document.addEventListener("keydown", function(e){ if(e.key === "Escape") cerrar(); });
    $$(".nav-movil a").forEach(function(a){ a.addEventListener("click", cerrar); });

    $$("[data-acordeon]").forEach(function(item){
      var b = item.querySelector("button");
      if(!b) return;
      b.addEventListener("click", function(){
        var ab = item.hasAttribute("data-abierto");
        item.toggleAttribute("data-abierto", !ab);
        b.setAttribute("aria-expanded", String(!ab));
      });
    });

    {%- if section.settings.mostrar_cotizador -%}
    var clpCot = function(n){ return "$" + Math.round(n).toLocaleString("es-CL"); };

    /* ============================================================
     COTIZADOR DE EVENTOS

     Las cantidades (tragos, baristas, café, leche) se calculan con los
     supuestos de abajo. Son cifras de operación habituales; si tu barra
     rinde distinto, cambia SUPUESTOS y listo.

     Los precios salen de TARIFAS. Mientras estén en null, el cotizador
     muestra el desglose de cantidades y ofrece pedir el valor, en vez de
     inventar una cifra.
     ============================================================ */
    // Las tarifas salen de los ajustes. 0 = todavía sin definir, y entonces
    // el cotizador muestra las cantidades sin inventar un precio.
    function tarifa(v){ return (v && v > 0) ? v : null; }
    var TARIFAS = {
      barra_cafe:  { por_persona: tarifa({{ section.settings.cot_barra | default: 0 }}),
                     horas_incluidas: {{ section.settings.cot_horas_incluidas | default: 3 }},
                     minimo_personas: {{ section.settings.cot_minimo | default: 30 }} },
      cocteles:    { por_persona: tarifa({{ section.settings.cot_cocteles | default: 0 }}),
                     horas_incluidas: {{ section.settings.cot_horas_incluidas | default: 3 }},
                     minimo_personas: {{ section.settings.cot_minimo | default: 30 }} },
      hora_extra:  { por_persona: tarifa({{ section.settings.cot_hora_extra | default: 0 }}) },
      iced:        { por_persona: tarifa({{ section.settings.cot_iced | default: 0 }}) },
      coldfoam:    { por_persona: tarifa({{ section.settings.cot_coldfoam | default: 0 }}) },
      traslado:    tarifa({{ section.settings.cot_traslado | default: 0 }})
    };

  var SUPUESTOS = {
    // Consumo por persona: la primera hora se toma más que las siguientes
    tragos_primera_hora: 0.9,
    tragos_hora_siguiente: 0.45,
    cocteles_primera_hora: 0.8,
    cocteles_hora_siguiente: 0.4,
    // Cuánto rinde un barista por hora, con máquina de dos grupos
    tragos_por_barista_hora: 70,
    cocteles_por_barista_hora: 45,
    // Gramos de café por trago (doble)
    gramos_por_trago: 18,
    // Proporción de tragos con leche, y mililitros por trago
    proporcion_con_leche: 0.6,
    ml_leche_por_trago: 180
  };

  // Para pedir la cotización. Carga uno de los dos y el botón lo usa.
    var CONTACTO = { whatsapp: {{ section.settings.cot_whatsapp | default: "" | json }},
                     correo:   {{ section.settings.cot_correo | default: "" | json }} };

  (function(){
    var sec = $("#eventos");
    if(!sec) return;

    var estado = { servicio:"barra", personas:80, horas:3, iced:false, coldfoam:false };

    function grupo(nombre){ return $('[data-cot="' + nombre + '"]'); }
    function elegido(nombre){
      var b = grupo(nombre).querySelector('button[aria-pressed="true"]');
      return b ? b.dataset.val : null;
    }

    function calcular(){
      var p = Math.max(1, estado.personas), h = estado.horas;
      var s = estado.servicio;
      var hayBarra = (s === "barra" || s === "ambos");
      var hayCoct  = (s === "cocteles" || s === "ambos");

      // Si se contratan las dos, el consumo se reparte, no se duplica
      var reparto = (s === "ambos") ? 0.6 : 1;

      var tragosBarra = hayBarra ? p * reparto *
        (SUPUESTOS.tragos_primera_hora + SUPUESTOS.tragos_hora_siguiente * (h - 1)) : 0;
      var tragosCoct = hayCoct ? p * reparto *
        (SUPUESTOS.cocteles_primera_hora + SUPUESTOS.cocteles_hora_siguiente * (h - 1)) : 0;

      var baristas = 0;
      if(hayBarra) baristas += Math.ceil(tragosBarra / h / SUPUESTOS.tragos_por_barista_hora);
      if(hayCoct)  baristas += Math.ceil(tragosCoct / h / SUPUESTOS.cocteles_por_barista_hora);
      baristas = Math.max(1, baristas);

      var tragos = Math.round(tragosBarra + tragosCoct);
      var cafeKg = (tragos * SUPUESTOS.gramos_por_trago) / 1000;
      var lecheL = hayBarra
        ? (tragosBarra * SUPUESTOS.proporcion_con_leche * SUPUESTOS.ml_leche_por_trago) / 1000
        : 0;

      // ---- precio ----
      var total = 0, completo = true, lineas = [];
      function sumar(tarifa, etiqueta, personas){
        if(tarifa === null || tarifa === undefined){ completo = false; return; }
        var monto = tarifa * personas;
        total += monto; lineas.push([etiqueta, monto]);
      }
      if(hayBarra) sumar(TARIFAS.barra_cafe.por_persona, "Barra de café", p);
      if(hayCoct)  sumar(TARIFAS.cocteles.por_persona, "Espresso martini y carajillo", p);

      var incluidas = hayBarra ? TARIFAS.barra_cafe.horas_incluidas
                               : TARIFAS.cocteles.horas_incluidas;
      var extra = Math.max(0, h - incluidas);
      if(extra > 0) sumar(TARIFAS.hora_extra.por_persona, extra + " h adicional" + (extra>1?"es":""), p * extra);
      if(hayBarra && estado.iced)     sumar(TARIFAS.iced.por_persona, "Iced coffee", p);
      if(hayBarra && estado.coldfoam) sumar(TARIFAS.coldfoam.por_persona, "Cold brew con cold foam", p);
      if(TARIFAS.traslado !== null){ total += TARIFAS.traslado; lineas.push(["Traslado", TARIFAS.traslado]); }

      return { tragos:tragos, baristas:baristas, cafeKg:cafeKg, lecheL:lecheL,
               hayBarra:hayBarra, total:total, completo:completo && lineas.length > 0,
               personas:p, horas:h };
    }

    function pintarCot(){
      var c = calcular();
      $("[data-cot-tragos]").textContent = c.tragos.toLocaleString("es-CL") + " tragos";
      $("[data-cot-baristas]").textContent = c.baristas + (c.baristas === 1 ? " barista" : " baristas");
      $("[data-cot-cafe]").textContent = (c.cafeKg < 1
        ? Math.round(c.cafeKg * 1000) + " g" : c.cafeKg.toFixed(1).replace(".", ",") + " kg");
      var filaLeche = $("[data-cot-fila-leche]");
      filaLeche.hidden = !c.hayBarra;
      if(c.hayBarra) $("[data-cot-leche]").textContent =
        Math.round(c.lecheL).toLocaleString("es-CL") + " L";

      var val = $("[data-cot-total]"), nota = $("[data-cot-nota]");
      if(c.completo){
        val.textContent = clpCot(c.total);
        nota.textContent = "Valor estimado para " + c.personas + " personas y " +
                           c.horas + " horas. La cotización firme va por escrito.";
      } else {
        val.textContent = "Te lo confirmamos";
        nota.textContent = "Todavía no publicamos las tarifas. Pídenos el valor y " +
                           "te respondemos con la cotización firme.";
      }

      // Los agregados son solo de la barra de café
      $$("[data-solo-barra]").forEach(function(e){ e.hidden = !c.hayBarra; });
      var soloCoct = $("[data-solo-cocteles]");
      if(soloCoct) soloCoct.hidden = c.hayBarra;

      // El botón arma el mensaje con todo lo elegido
      var servicio = { barra:"barra de café", cocteles:"espresso martini y carajillo",
                       ambos:"barra de café y coctelería" }[estado.servicio];
      var agregados = [];
      if(c.hayBarra && estado.iced) agregados.push("iced coffee");
      if(c.hayBarra && estado.coldfoam) agregados.push("cold brew con cold foam");
      var msg = "Hola, quiero cotizar un evento con Sepia Coffee.\n\n" +
        "Servicio: " + servicio + "\n" +
        "Invitados: " + c.personas + "\n" +
        "Horas: " + c.horas + "\n" +
        (agregados.length ? "Agregados: " + agregados.join(", ") + "\n" : "") +
        "\nEstimación del sitio: " + c.tragos + " tragos, " + c.baristas +
        (c.baristas === 1 ? " barista" : " baristas") + ".";
      var btn = $("[data-cot-pedir]");
      if(CONTACTO.whatsapp){
        btn.href = "https://wa.me/" + CONTACTO.whatsapp.replace(/[^0-9]/g, "") +
                   "?text=" + encodeURIComponent(msg);
        btn.target = "_blank"; btn.rel = "noopener";
      } else if(CONTACTO.correo){
        btn.href = "mailto:" + CONTACTO.correo +
                   "?subject=" + encodeURIComponent("Cotización de evento") +
                   "&body=" + encodeURIComponent(msg);
      } else {
        btn.href = "#boletin";
      }
      btn.dataset.mensaje = msg;
    }

    // ---- controles ----
    ["servicio", "horas"].forEach(function(nombre){
      var g = grupo(nombre);
      if(!g) return;
      Array.prototype.slice.call(g.querySelectorAll("button")).forEach(function(b){
        b.addEventListener("click", function(){
          Array.prototype.slice.call(g.querySelectorAll("button")).forEach(function(o){ o.setAttribute("aria-pressed", String(o === b)); });
          estado[nombre] = (nombre === "horas") ? parseInt(b.dataset.val, 10) : b.dataset.val;
          pintarCot();
        });
      });
    });

    var num = $("[id^='cot-personas-']:not([id$='-r'])"),
        rango = $("[id$='-r']");
    function sincronizar(valor, desdeRango){
      var v = Math.max(1, Math.min(2000, parseInt(valor, 10) || 1));
      estado.personas = v;
      if(!desdeRango) rango.value = Math.max(20, Math.min(400, v));
      else num.value = v;
      pintarCot();
    }
    num.addEventListener("input", function(){ sincronizar(num.value, false); });
    rango.addEventListener("input", function(){ sincronizar(rango.value, true); });

    $$("[data-agregado]").forEach(function(c){
      c.addEventListener("change", function(){
        estado[c.dataset.agregado] = c.checked;
        pintarCot();
      });
    });

    pintarCot();
  })();
    {%- endif -%}
  }

  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", iniciar);
  else iniciar();
  document.addEventListener("shopify:section:load", function(e){
    if(e.detail && e.detail.sectionId === ID) iniciar();
  });
})();
</script>

{% schema %}
{
  "name": "Sepia — Portada v2",
  "tag": "section",
  "class": "seccion-sepia2",
  "settings": [
    {
      "type": "header",
      "content": "Marca"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Opcional. Sin logo se usa el nombre en texto."
    },
    {
      "type": "text",
      "id": "marca_texto",
      "label": "Nombre en texto",
      "default": "Sepia Coffee"
    },
    {
      "type": "header",
      "content": "Barra de anuncio"
    },
    {
      "type": "checkbox",
      "id": "mostrar_anuncio",
